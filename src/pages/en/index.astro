---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import BeforeAfterSlider from "../../components/BeforeAfterSlider.astro";
import before from "@assets/before.jpeg";
import after from "@assets/after.jpeg";
---

<Layout>
  <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-8">

    <!-- Hero Section -->
    <section class="min-h-[88vh] flex items-center py-16 md:py-24">
      <div class="max-w-4xl w-full">
        <div class="bg-surface-bright/85 backdrop-blur-md rounded-2xl p-8 md:p-12 shadow-lg border border-on-surface/10">
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 bg-secondary-container text-on-secondary-container rounded-full font-label text-xs uppercase tracking-[0.2em] shadow-sm"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-secondary inline-block"></span>
            Gudbrandsdalen Valley
          </div>
          <h1
            class="font-sketch font-bold text-4xl md:text-6xl text-primary mb-6 leading-[1.05]"
          >
            We're turning an old forge into a chapel.
          </h1>
          <div class="w-20 h-px bg-secondary/40 mb-6"></div>
          <p class="font-headline italic text-lg md:text-xl text-tertiary mb-4 leading-relaxed">
            Four friends, one abandoned building, and a lot of weekends.
          </p>
          <p class="font-body text-sm md:text-base text-on-surface-variant mb-10 leading-relaxed">
            There's an old forge on Ledum Farm in Gudbrandsdalen that's been sitting empty for decades.
            We think it should be a chapel — a quiet place anyone can walk into.
            So we're building it ourselves.
          </p>
          <div class="flex flex-wrap gap-6 items-center">
            <a
              class="inline-flex items-center gap-2 px-8 min-h-[44px] bg-primary text-on-primary rounded-sm font-label text-sm hover:bg-primary/90 transition-colors shadow-lg tracking-wide"
              href="story"
            >
              Our Story
              <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
            </a>
            <a
              class="font-headline italic text-lg text-primary/80 hover:text-primary border-b border-primary/20 pb-0.5 hover:border-primary/60 transition-all min-h-[44px] inline-flex items-center"
              href="https://www.spleis.no/project/485151?s=c"
              target="_blank"
              rel="noopener noreferrer"
            >
              Support us
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- At a glance — stat strip -->
    <section aria-label="Project overview" class="py-16 flex justify-center px-4">
      <div class="bg-black/55 backdrop-blur-sm rounded-2xl border border-white/10">
        <div class="flex flex-wrap divide-x divide-white/20">
          <div class="flex flex-col items-center px-8 py-6 text-center min-w-[120px]">
            <span class="font-sketch text-4xl text-white font-bold leading-none">2022</span>
            <span class="font-label text-xs uppercase tracking-widest text-white/85 mt-2">Project start</span>
          </div>
          <div class="flex flex-col items-center px-8 py-6 text-center min-w-[120px]">
            <span class="font-sketch text-4xl text-white font-bold leading-none">4</span>
            <span class="font-label text-xs uppercase tracking-widest text-white/85 mt-2">Builders</span>
          </div>
          <div class="flex flex-col items-center px-8 py-6 text-center min-w-[120px]">
            <span class="font-sketch text-4xl text-white font-bold leading-none">100%</span>
            <span class="font-label text-xs uppercase tracking-widest text-white/85 mt-2">Raised</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Thin ornamental divider -->
    <div class="flex items-center gap-6 mb-24 opacity-60" aria-hidden="true">
      <div class="flex-1 h-px bg-gradient-to-r from-transparent to-white/60"></div>
      <span class="material-symbols-outlined text-white/80 text-xl drop-shadow">spa</span>
      <div class="flex-1 h-px bg-gradient-to-l from-transparent to-white/60"></div>
    </div>

    <!-- Story blurb -->
    <section class="mb-16 px-4 reveal" aria-labelledby="story-blurb-heading">
      <div class="max-w-2xl mx-auto bg-surface-bright/80 backdrop-blur-sm rounded-2xl p-8 md:p-12 border border-on-surface/10 shadow-lg text-center">
        <h2
          id="story-blurb-heading"
          class="font-headline text-4xl italic text-primary mb-5 leading-tight"
        >Here's how it started.</h2>
        <p class="font-body text-base md:text-lg text-on-surface-variant leading-relaxed mb-8">
          Mathias grew up hearing stories about the old forge on Ledum Farm.
          When he finally walked in as an adult — cold stone, no roof to speak of, decades of quiet —
          he didn't see a ruin. He saw a room that hadn't found its purpose yet.
          He called three of us. We said yes.
        </p>
        <a href="story" class="inline-flex items-center gap-2 min-h-[44px] px-6 font-label text-sm text-primary hover:text-primary/70 transition-colors uppercase tracking-widest">
          Read the full story
          <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </section>

    <!-- Before/After slider -->
    <section class="mb-32 reveal" aria-label="The chapel before and after">
      <div class="bg-surface-container-lowest p-3 shadow-xl" style="box-shadow: 3px 5px 24px rgba(0,0,0,0.18);">
        <BeforeAfterSlider
          before={before}
          after={after}
          beforeLabel="Before"
          afterLabel="After"
          alt="The chapel"
        />
        <p id="slider-hint" class="font-sketch text-base text-tertiary mt-3 px-1">Drag or use arrow keys to see the progress</p>
      </div>
    </section>

    <!-- Fundraiser Section -->
    <section class="mb-24 relative overflow-hidden reveal">
      <div
        class="fundraiser-panel"
      >
        <!-- Top rule -->
        <div class="flex items-center gap-4 mb-10">
          <div class="flex-1 h-px bg-secondary/20"></div>
          <span class="font-sketch text-secondary/60 text-sm tracking-widest uppercase">Support the project</span>
          <div class="flex-1 h-px bg-secondary/20"></div>
        </div>

        <div class="max-w-xl mx-auto text-center">
          <h2 class="font-headline text-4xl md:text-5xl italic text-primary mb-4 leading-tight">
            We're raising 400,000 kr<br/>to finish the chapel.
          </h2>
          <p class="font-body text-base text-tertiary mb-8 leading-relaxed">
            We need to finish the windows, lay the floor, and get the inside ready.
            Every donation goes straight to the building — no overhead, no admin.
            If you'd like to be part of this, we'd love to have you.
          </p>

          <!-- Progress bar -->
          <div class="mb-8">
            <div class="text-center mb-4">
              <div class="font-sketch text-5xl md:text-6xl text-primary font-bold leading-none mb-1">400 000 kr</div>
              <div class="font-label text-xs uppercase tracking-widest text-secondary/70">fundraising goal</div>
            </div>
            <div class="flex justify-between font-sketch text-base text-secondary mb-2">
              <span>Raised so far</span>
              <span>100%</span>
            </div>
            <div class="h-3 bg-secondary/10 rounded-full overflow-hidden border border-secondary/10">
              <div class="progress-bar-fill h-full bg-gradient-to-r from-secondary to-primary rounded-full"></div>
            </div>
          </div>

          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://www.spleis.no/project/485151?s=c"
            class="btn-pulse btn-touch inline-flex items-center gap-3 bg-primary text-on-primary px-10 py-4 rounded-sm font-label text-sm hover:bg-primary/90 shadow-lg transition-colors tracking-wide"
          >
            Donate here
            <span class="material-symbols-outlined text-base" aria-hidden="true">favorite</span>
          </a>
        </div>

        <!-- Bottom rule -->
        <div class="flex items-center gap-4 mt-10">
          <div class="flex-1 h-px bg-secondary/20"></div>
          <span class="font-sketch text-secondary/40 text-xl" aria-hidden="true">✦</span>
          <div class="flex-1 h-px bg-secondary/20"></div>
        </div>
      </div>
    </section>

  </main>
</Layout>

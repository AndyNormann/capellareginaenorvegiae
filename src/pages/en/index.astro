---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import BeforeAfterSlider from "../../components/BeforeAfterSlider.astro";
import before from "@assets/before.jpeg";
import after from "@assets/after.jpeg";
---

<Layout>
  <main class="max-w-6xl mx-auto px-4 sm:px-8">

    <!-- Hero Section -->
    <section class="min-h-[88vh] flex items-center py-16 md:py-24">
      <div class="max-w-4xl w-full">
        <div class="bg-surface-bright/85 backdrop-blur-md rounded-2xl p-8 md:p-10 shadow-lg border border-on-surface/10">
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 bg-secondary-container text-on-secondary-container rounded-full font-label text-xs uppercase tracking-[0.2em] shadow-sm"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-secondary inline-block"></span>
            Gudbrandsdalen Valley
          </div>
          <h1
            class="font-sketch text-4xl md:text-6xl text-primary mb-6 leading-[1.05]"
          >
            We're turning an old forge into a chapel.
          </h1>
          <div class="w-20 h-px bg-secondary/40 mb-6"></div>
          <p class="font-headline italic text-lg md:text-xl text-tertiary mb-4 leading-relaxed">
            Four friends, one abandoned building, and a lot of weekends.
          </p>
          <p class="font-body text-sm md:text-base text-on-surface-variant mb-10 leading-relaxed">
            There's an old forge on Ledum Farm in Gudbrandsdalen that's been sitting empty for decades.
            We think it should be a chapel — a quiet place anyone can walk into.
            So we're building it ourselves.
          </p>
          <div class="flex flex-wrap gap-6 items-center">
            <a
              class="flex items-center gap-2 px-8 py-3.5 bg-primary text-on-primary rounded-sm font-label text-sm hover:bg-primary/90 transition-colors shadow-lg tracking-wide"
              href="story"
            >
              Our Story
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
            <a
              class="font-headline italic text-lg text-primary/80 hover:text-primary border-b border-primary/20 pb-0.5 hover:border-primary/60 transition-all"
              href="https://www.spleis.no/project/485151?s=c"
              target="_blank"
            >
              Support us
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Background showcase -->
    <section class="min-h-[40vh] flex items-center justify-end pr-4 md:pr-12">
    </section>

    <!-- Thin ornamental divider -->
    <div class="flex items-center gap-6 mb-24 opacity-60">
      <div class="flex-1 h-px bg-gradient-to-r from-transparent to-white/60"></div>
      <span class="material-symbols-outlined text-white/80 text-xl" style="text-shadow: 0 1px 4px rgba(0,0,0,0.4);">spa</span>
      <div class="flex-1 h-px bg-gradient-to-l from-transparent to-white/60"></div>
    </div>

    <!-- Story blurb -->
    <section class="mb-16 max-w-2xl mx-auto text-center reveal">
      <h2 class="font-headline text-4xl italic text-white mb-5 leading-tight [text-shadow:0_1px_4px_rgba(0,0,0,0.9),0_4px_16px_rgba(0,0,0,0.6)]">Here's how it started.</h2>
      <p class="font-body text-lg text-white/90 leading-relaxed [text-shadow:0_1px_3px_rgba(0,0,0,0.9),0_3px_12px_rgba(0,0,0,0.5)]">
        Mathias grew up hearing stories about the old forge on Ledum Farm.
        When he finally walked in as an adult — cold stone, no roof to speak of, decades of quiet —
        he didn't see a ruin. He saw a room that hadn't found its purpose yet.
        He called three of us. We said yes.
      </p>
      <a href="story" class="inline-flex items-center gap-2 mt-6 font-label text-sm text-white/70 hover:text-white transition-colors uppercase tracking-widest">
        Read the full story
        <span class="material-symbols-outlined text-base">arrow_forward</span>
      </a>
    </section>

    <!-- Before/After slider -->
    <section class="mb-32 reveal">
      <div class="bg-surface-container-lowest p-3 shadow-xl" style="box-shadow: 3px 5px 24px rgba(0,0,0,0.18);">
        <BeforeAfterSlider
          before={before}
          after={after}
          beforeLabel="Before"
          afterLabel="After"
          alt="The chapel"
        />
        <p class="font-sketch text-base text-tertiary mt-3 px-1">Drag to see the progress</p>
      </div>
    </section>

    <!-- Fundraiser Section -->
    <section class="mb-24 relative overflow-hidden reveal">
      <div
        class="fundraiser-panel"
      >
        <!-- Top rule -->
        <div class="flex items-center gap-4 mb-10">
          <div class="flex-1 h-px bg-secondary/20"></div>
          <span class="font-sketch text-secondary/60 text-sm tracking-widest uppercase">Support the project</span>
          <div class="flex-1 h-px bg-secondary/20"></div>
        </div>

        <div class="max-w-xl mx-auto text-center">
          <h2 class="font-headline text-4xl md:text-5xl italic text-primary mb-4 leading-tight">
            We're raising 400,000 kr<br/>to finish the chapel.
          </h2>
          <p class="font-body text-base text-tertiary mb-8 leading-relaxed">
            We need to finish the windows, lay the floor, and get the inside ready.
            Every donation goes straight to the building — no overhead, no admin.
            If you'd like to be part of this, we'd love to have you.
          </p>

          <!-- Progress bar -->
          <div class="mb-8">
            <div class="text-center mb-4">
              <div class="font-sketch text-5xl md:text-6xl text-primary font-bold leading-none mb-1">400 000 kr</div>
              <div class="font-label text-xs uppercase tracking-widest text-secondary/70">fundraising goal</div>
            </div>
            <div class="flex justify-between font-sketch text-base text-secondary mb-2">
              <span>Raised so far</span>
              <span>100%</span>
            </div>
            <div class="h-3 bg-secondary/10 rounded-full overflow-hidden border border-secondary/10">
              <div class="progress-bar-fill h-full bg-gradient-to-r from-secondary to-primary rounded-full"></div>
            </div>
          </div>

          <a
            target="_blank"
            href="https://www.spleis.no/project/485151?s=c"
            class="btn-pulse inline-flex items-center gap-3 bg-primary text-on-primary px-10 py-4 rounded-sm font-label text-sm hover:bg-primary/90 shadow-lg transition-colors tracking-wide"
          >
            Donate here
            <span class="material-symbols-outlined text-base">favorite</span>
          </a>
        </div>

        <!-- Bottom rule -->
        <div class="flex items-center gap-4 mt-10">
          <div class="flex-1 h-px bg-secondary/20"></div>
          <span class="font-sketch text-secondary/40 text-xl">✦</span>
          <div class="flex-1 h-px bg-secondary/20"></div>
        </div>
      </div>
    </section>

  </main>
</Layout>

---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import BeforeAfterSlider from "../../components/BeforeAfterSlider.astro";
import before from "@assets/before.jpeg";
import after from "@assets/after.jpeg";
import kapellUte from "@assets/kapell_ute.jpeg";
import kapellUte1 from "@assets/kapell_ute1.jpeg";
import kapellInnsyn from "@assets/kapell_innsyn.jpeg";
import gudbrandsdalen from "@assets/gudbrandsdalen.jpg";
import dalen2 from "@assets/dalen2.jpg";
import favang from "@assets/fåvang.jpg";
---

<Layout>
  <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-8">

    <!-- Hero Section — two-column split -->
    <section class="py-24 md:py-32">
      <div class="grid md:grid-cols-[1fr_480px] lg:grid-cols-[1fr_600px] gap-12 md:gap-16 items-center">

        <!-- Left: text content -->
        <div>
          <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 bg-secondary-container text-on-secondary-container rounded-full font-label text-xs uppercase tracking-[0.2em]">
            <span class="w-1.5 h-1.5 rounded-full bg-secondary inline-block"></span>
            Gudbrandsdalen, Norge
          </div>
          <h1 class="font-sketch font-bold text-5xl md:text-6xl text-primary mb-6 leading-[1.05]">
            Vi bygger om en gammel smie til kapell.
          </h1>
          <div class="w-16 h-px bg-secondary/40 mb-6"></div>
          <p class="font-headline italic text-lg md:text-xl text-tertiary mb-4 leading-relaxed">
            Fire venner, ett tomt bygg, og mange helger.
          </p>
          <p class="font-body text-sm md:text-base text-on-surface-variant mb-10 leading-relaxed max-w-lg">
            Det ligger en gammel smie på Ledum Gård i Gudbrandsdalen som har stått tom i årtier.
            Vi mener den bør bli et kapell — et stille sted alle kan gå inn i.
            Så vi bygger det selv.
          </p>
          <div class="flex flex-wrap gap-4 items-center">
            <a
              class="inline-flex items-center gap-2 px-8 min-h-[44px] bg-primary text-on-primary rounded-sm font-label text-sm hover:bg-primary/90 transition-colors shadow-md tracking-wide"
              href="/capellareginaenorvegiae/no/story"
            >
              Vår Historie
              <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
            </a>
            <a
              class="font-headline italic text-lg text-primary/80 hover:text-primary border-b border-primary/20 pb-0.5 hover:border-primary/60 transition-all min-h-[44px] inline-flex items-center"
              href="https://www.spleis.no/project/485151?s=c"
              target="_blank"
              rel="noopener noreferrer"
            >
              Støtt oss
            </a>
          </div>
        </div>

        <!-- Right: hero image -->
        <div class="relative">
          <Image
            src={dalen2}
            alt="Gudbrandsdalen-dalen i solnedgang"
            class="w-full h-[400px] md:h-[600px] object-cover rounded-2xl shadow-xl"
          />
        </div>
      </div>
    </section>

    <!-- Stat strip -->
    <section aria-label="Prosjektoversikt" class="mb-24">
      <div class="bg-surface-container rounded-2xl">
        <div class="flex flex-wrap divide-x divide-outline-variant">
          <div class="flex flex-col items-center px-8 py-6 text-center min-w-[120px] flex-1">
            <span class="font-sketch text-4xl text-primary font-bold leading-none">2022</span>
            <span class="font-label text-xs uppercase tracking-widest text-on-surface-variant mt-2">Prosjektstart</span>
          </div>
          <div class="flex flex-col items-center px-8 py-6 text-center min-w-[120px] flex-1">
            <span class="font-sketch text-4xl text-primary font-bold leading-none">4</span>
            <span class="font-label text-xs uppercase tracking-widest text-on-surface-variant mt-2">Byggevenner</span>
          </div>
          <div class="flex flex-col items-center px-8 py-6 text-center min-w-[120px] flex-1">
            <span class="font-sketch text-4xl text-primary font-bold leading-none">100%</span>
            <span class="font-label text-xs uppercase tracking-widest text-on-surface-variant mt-2">Innsamlet</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Photo gallery -->
    <section class="mb-24" aria-label="Gudbrandsdalen">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
        <Image
          src={kapellUte1}
          alt="Gudbrandsdalen-dalen"
          class="w-full h-64 md:h-96 object-cover rounded-xl"
        />
        <Image
          src={kapellInnsyn}
          alt="Dalen"
          class="w-full h-64 md:h-96 object-cover rounded-xl"
        />
        <Image
					src={kapellUte}
          alt="Fåvang"
          class="w-full h-64 md:h-96 object-cover rounded-xl col-span-2 md:col-span-1"
        />
      </div>
    </section>

    <!-- Ornamental divider -->
    <div class="flex items-center gap-6 mb-16 opacity-40" aria-hidden="true">
      <div class="flex-1 h-px bg-outline-variant"></div>
      <span class="material-symbols-outlined text-secondary text-xl">spa</span>
      <div class="flex-1 h-px bg-outline-variant"></div>
    </div>

    <!-- Story blurb -->
    <section class="mb-16 reveal" aria-labelledby="story-blurb-heading">
      <div class="max-w-2xl mx-auto bg-surface-container-low rounded-2xl p-8 md:p-12 border border-outline-variant text-center">
        <h2
          id="story-blurb-heading"
          class="font-headline text-4xl italic text-primary mb-5 leading-tight"
        >Slik begynte det.</h2>
        <p class="font-body text-base md:text-lg text-on-surface-variant leading-relaxed mb-8">
          Mathias vokste opp med historier om den gamle smia på Ledum Gård.
          Da han gikk inn som voksen — kald stein, støvete lys, årtier med stillhet —
          så han ikke en ruin. Han så et rom som ikke hadde funnet sin plass ennå.
          Han ringte tre av oss. Vi sa ja.
        </p>
        <a href="/capellareginaenorvegiae/no/story" class="inline-flex items-center gap-2 min-h-[44px] px-6 font-label text-sm text-primary hover:text-primary/70 transition-colors uppercase tracking-widest">
          Les hele historien
          <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </section>

    <!-- Before/After slider -->
    <section class="mb-32 reveal" aria-label="Kapellet før og etter">
      <div class="bg-surface-container-lowest p-3 shadow-md rounded-sm">
        <BeforeAfterSlider
          before={before}
          after={after}
          beforeLabel="Før"
          afterLabel="Etter"
          alt="Kapellet"
        />
        <p id="slider-hint" class="font-sketch text-base text-tertiary mt-3 px-1">Dra eller bruk piltaster for å se fremgangen</p>
      </div>
    </section>

    <!-- Fundraiser Section -->
    <section class="mb-24 relative overflow-hidden reveal">
      <div class="fundraiser-panel">
        <!-- Top rule -->
        <div class="flex items-center gap-4 mb-10">
          <div class="flex-1 h-px bg-secondary/20"></div>
          <span class="font-sketch text-secondary/60 text-sm tracking-widest uppercase">Støtt prosjektet</span>
          <div class="flex-1 h-px bg-secondary/20"></div>
        </div>

        <div class="max-w-xl mx-auto text-center">
          <h2 class="font-headline text-4xl md:text-5xl italic text-primary mb-4 leading-tight">
            Vi samler inn 400 000 kr<br/>for å fullføre kapellet.
          </h2>
          <p class="font-body text-base text-tertiary mb-8 leading-relaxed">
            Vi mangler vinduer, gulv og det som gjør et skjelett til et rom.
            Alle bidrag går rett til bygget — ingen administrasjon, ingen mellomledd.
            Hvis du vil være med på dette, setter vi stor pris på det.
          </p>

          <!-- Progress bar -->
          <div class="mb-8">
            <div class="text-center mb-4">
              <div class="font-sketch text-5xl md:text-6xl text-primary font-bold leading-none mb-1">400 000 kr</div>
              <div class="font-label text-xs uppercase tracking-widest text-secondary/70">innsamlet mål</div>
            </div>
            <div class="flex justify-between font-sketch text-base text-secondary mb-2">
              <span>Innsamlet så langt</span>
              <span>100%</span>
            </div>
            <div class="h-3 bg-secondary/10 rounded-full overflow-hidden border border-secondary/10">
              <div class="progress-bar-fill h-full bg-gradient-to-r from-secondary to-primary rounded-full"></div>
            </div>
          </div>

          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://www.spleis.no/project/485151?s=c"
            class="btn-pulse btn-touch inline-flex items-center gap-3 bg-primary text-on-primary px-10 py-4 rounded-sm font-label text-sm hover:bg-primary/90 shadow-lg transition-colors tracking-wide"
          >
            Gi en gave
            <span class="material-symbols-outlined text-base" aria-hidden="true">favorite</span>
          </a>
        </div>

        <!-- Bottom rule -->
        <div class="flex items-center gap-4 mt-10">
          <div class="flex-1 h-px bg-secondary/20"></div>
          <span class="font-sketch text-secondary/40 text-xl" aria-hidden="true">✦</span>
          <div class="flex-1 h-px bg-secondary/20"></div>
        </div>
      </div>
    </section>

  </main>
</Layout>

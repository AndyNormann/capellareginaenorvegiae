---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import BeforeAfterSlider from "../../components/BeforeAfterSlider.astro";
import before from "@assets/before.jpeg";
import after from "@assets/after.jpeg";
import dalen from "@assets/dalen_sundown.jpg";
---

<Layout>
  <main class="max-w-6xl mx-auto px-4 sm:px-8">

    <!-- Hero Section -->
    <section class="min-h-[88vh] flex items-center py-16 md:py-24">
      <div class="max-w-4xl w-full">
        <div class="bg-surface-bright/85 backdrop-blur-md rounded-2xl p-8 md:p-10 shadow-lg border border-on-surface/10">
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 bg-secondary-container text-on-secondary-container rounded-full font-label text-xs uppercase tracking-[0.2em] shadow-sm"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-secondary inline-block"></span>
            Gudbrandsdalen, Norge
          </div>
          <h1
            class="font-sketch text-4xl md:text-6xl text-primary mb-6 leading-[1.05]"
          >
            Der ilden en gang brant, skal lyset nå hvile.
          </h1>
          <div class="w-20 h-px bg-secondary/40 mb-6"></div>
          <p class="font-headline italic text-lg md:text-xl text-tertiary mb-4 leading-relaxed">
            En forlatt smie på Ledum Gård. Fire venner med ett felles kall.
          </p>
          <p class="font-body text-sm md:text-base text-on-surface-variant mb-10 leading-relaxed">
            I generasjoner lyste flammene fra smia i Gudbrandsdalen. Så ble det stille.
            Nå er vi fire venner som har tatt på oss oppgaven å gi dette forfalne rommet
            et nytt hjerte — et stille kapell der alle er velkomne.
          </p>
          <div class="flex flex-wrap gap-6 items-center">
            <a
              class="flex items-center gap-2 px-8 py-3.5 bg-primary text-on-primary rounded-sm font-label text-sm hover:bg-primary/90 transition-colors shadow-lg tracking-wide"
              href="story"
            >
              Vår Historie
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
            <a
              class="font-headline italic text-lg text-primary/80 hover:text-primary border-b border-primary/20 pb-0.5 hover:border-primary/60 transition-all"
              href="https://www.spleis.no/project/485151?s=c"
              target="_blank"
            >
              Støtt oss
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Background showcase -->
    <section class="min-h-screen"></section>

    <!-- Thin ornamental divider -->
    <div class="flex items-center gap-6 mb-24 opacity-60">
      <div class="flex-1 h-px bg-gradient-to-r from-transparent to-white/60"></div>
      <span class="material-symbols-outlined text-white/80 text-xl" style="text-shadow: 0 1px 4px rgba(0,0,0,0.4);">spa</span>
      <div class="flex-1 h-px bg-gradient-to-l from-transparent to-white/60"></div>
    </div>

    <!-- Story blurb -->
    <section class="mb-16 max-w-2xl mx-auto text-center">
      <h2 class="font-headline text-4xl italic text-white mb-5 leading-tight [text-shadow:0_1px_4px_rgba(0,0,0,0.9),0_4px_16px_rgba(0,0,0,0.6)]">Asken er kald. Arbeidet begynner.</h2>
      <p class="font-body text-lg text-white/90 leading-relaxed [text-shadow:0_1px_3px_rgba(0,0,0,0.9),0_3px_12px_rgba(0,0,0,0.5)]">
        I generasjoner lyste flammene fra smia på Ledum Gård. Så ble det stille.
        Esse etter esse sluknet, og steinveggene sto tomme i årtier.
        Det var Mathias som så hva ingen andre hadde sett — ikke en ruin, men et rom som ventet.
        Han kalte på tre venner. Sammen bestemte de seg for å gi stedet et nytt hjerte.
      </p>
    </section>

    <!-- Before/After slider -->
    <section class="mb-32">
      <div class="bg-surface-container-lowest p-3 shadow-xl" style="box-shadow: 3px 5px 24px rgba(0,0,0,0.18);">
        <BeforeAfterSlider
          before={before}
          after={after}
          beforeLabel="Før"
          afterLabel="Etter"
          alt="Kapellet"
        />
        <p class="font-sketch text-base text-tertiary mt-3 px-1">Dra for å se fremgangen</p>
      </div>
    </section>

    <!-- Fundraiser Section -->
    <section class="mb-24 relative overflow-hidden">
      <div
        class="fundraiser-panel"
      >
        <!-- Top rule -->
        <div class="flex items-center gap-4 mb-10">
          <div class="flex-1 h-px bg-secondary/20"></div>
          <span class="font-sketch text-secondary/60 text-sm tracking-widest uppercase">Støtt prosjektet</span>
          <div class="flex-1 h-px bg-secondary/20"></div>
        </div>

        <div class="max-w-xl mx-auto text-center">
          <h2 class="font-headline text-4xl md:text-5xl italic text-primary mb-4 leading-tight">
            La ditt navn<br/>stå i steinene.
          </h2>
          <p class="font-body text-base text-tertiary mb-8 leading-relaxed">
            Det som en gang ble smidd i ild, skal nå reises av fellesskap.
            Tak, vinduer, det siste som gjenstår — hver krone bæres direkte inn
            i murene på Ledum Gård. Ingen mellomledd. Bare det som varer.
          </p>

          <!-- Fake progress bar -->
          <div class="mb-8">
            <div class="text-center mb-4">
              <div class="font-sketch text-5xl md:text-6xl text-primary font-bold leading-none mb-1">400 000 kr</div>
              <div class="font-label text-xs uppercase tracking-widest text-secondary/70">innsamlet mål</div>
            </div>
            <div class="flex justify-between font-sketch text-base text-secondary mb-2">
              <span>Innsamlet så langt</span>
              <span>100%</span>
            </div>
            <div class="h-3 bg-secondary/10 rounded-full overflow-hidden border border-secondary/10">
              <div
                class="h-full bg-gradient-to-r from-secondary to-primary rounded-full transition-all"
                style="width: 100%;"
              ></div>
            </div>
          </div>

          <a
            target="_blank"
            href="https://www.spleis.no/project/485151?s=c"
            class="inline-flex items-center gap-3 bg-primary text-on-primary px-10 py-4 rounded-sm font-label text-sm hover:bg-primary/90 shadow-lg transition-colors tracking-wide"
          >
            Gi en gave
            <span class="material-symbols-outlined text-base">favorite</span>
          </a>
        </div>

        <!-- Bottom rule -->
        <div class="flex items-center gap-4 mt-10">
          <div class="flex-1 h-px bg-secondary/20"></div>
          <span class="font-sketch text-secondary/40 text-xl">✦</span>
          <div class="flex-1 h-px bg-secondary/20"></div>
        </div>
      </div>
    </section>

  </main>
</Layout>

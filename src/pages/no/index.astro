---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import BeforeAfterSlider from "../../components/BeforeAfterSlider.astro";
import klem from "@assets/klem.jpg";
import before from "@assets/before.webp";
import after from "@assets/after.webp";
import dalen from "@assets/dalen_sundown.jpg";
---

<Layout>
  <main class="max-w-6xl mx-auto px-4 sm:px-8">

    <!-- Hero Section -->
    <section class="min-h-[88vh] grid grid-cols-1 md:grid-cols-12 gap-8 items-center py-16 md:py-24">
      <div class="md:col-span-7 order-2 md:order-1 relative z-10">
        <div class="bg-[#fbf9f4]/85 backdrop-blur-md rounded-2xl p-8 md:p-10 shadow-lg border border-white/40">
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 bg-secondary-container text-on-secondary-container rounded-full font-label text-xs uppercase tracking-[0.2em] shadow-sm"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-secondary inline-block"></span>
            Gudbrandsdalen, Norge
          </div>
          <h1
            class="font-sketch text-6xl md:text-8xl text-primary mb-6 leading-[1.05]"
          >
            Der hendene<br/>møter<br/>fjellsteinen.
          </h1>
          <div class="w-20 h-px bg-secondary/40 mb-8"></div>
          <p class="font-headline italic text-xl md:text-2xl text-tertiary mb-12 max-w-md leading-relaxed">
            Vi er fire venner med en drøm om å bygge et fristed for vår
            bygd.
          </p>
          <div class="flex flex-wrap gap-6 items-center">
            <a
              class="flex items-center gap-2 px-8 py-3.5 bg-primary text-on-primary rounded-sm font-label text-sm hover:bg-primary/90 transition-colors shadow-lg tracking-wide"
              href="story"
            >
              Vår Historie
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
            <a
              class="font-headline italic text-lg text-primary/80 hover:text-primary border-b border-primary/20 pb-0.5 hover:border-primary/60 transition-all"
              href="https://www.spleis.no/project/485151?s=c"
              target="_blank"
            >
              Støtt oss
            </a>
          </div>
        </div>
      </div>

      <!-- Polaroid photo -->
      <div class="md:col-span-5 order-1 md:order-2 relative flex justify-center md:justify-end">
        <div class="relative">
          <div
            class="relative bg-white p-3 pb-14 shadow-2xl rotate-2 w-72 md:w-80"
            style="box-shadow: 4px 6px 32px rgba(0,0,0,0.25), 0 1px 3px rgba(0,0,0,0.12);"
          >
            <Image
              alt="Fire venner i en tåkefull norsk dal"
              class="w-full aspect-square object-cover"
              src={klem}
            />
            <div class="absolute bottom-3 left-0 right-0 text-center font-sketch text-tertiary text-xl">
              August, 2023
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Thin ornamental divider -->
    <div class="flex items-center gap-6 mb-24 opacity-60">
      <div class="flex-1 h-px bg-gradient-to-r from-transparent to-white/60"></div>
      <span class="material-symbols-outlined text-white/80 text-xl" style="text-shadow: 0 1px 4px rgba(0,0,0,0.4);">spa</span>
      <div class="flex-1 h-px bg-gradient-to-l from-transparent to-white/60"></div>
    </div>

    <!-- Before/After + manuscript card -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-32 items-start">

      <!-- Slider -->
      <div class="bg-white p-3 shadow-xl -rotate-1" style="box-shadow: 3px 5px 24px rgba(0,0,0,0.18);">
        <BeforeAfterSlider
          before={before}
          after={after}
          beforeLabel="Før"
          afterLabel="Etter"
          alt="Kapellet"
        />
        <p class="font-sketch text-base text-tertiary mt-3 px-1">Dra for å se fremgangen</p>
      </div>

      <!-- Manuscript card -->
      <div class="md:pt-8">
        <div
          class="p-8 text-center bg-surface-bright/90 backdrop-blur-lg rounded-sm flex flex-col justify-center items-center border border-secondary/20 relative h-full"
          style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.8), 0 8px 32px rgba(0,0,0,0.08);"
        >
          <span class="absolute top-3 left-3 font-sketch text-secondary/30 text-2xl leading-none">✦</span>
          <span class="absolute top-3 right-3 font-sketch text-secondary/30 text-2xl leading-none">✦</span>
          <span class="absolute bottom-3 left-3 font-sketch text-secondary/30 text-2xl leading-none">✦</span>
          <span class="absolute bottom-3 right-3 font-sketch text-secondary/30 text-2xl leading-none">✦</span>

          <div class="w-10 h-px bg-secondary/30 mb-6"></div>
          <h2 class="font-headline text-3xl italic text-primary mb-5 leading-tight">
            Bygget<br/>med egne hender
          </h2>
          <p class="font-body text-tertiary leading-relaxed mb-6 text-sm max-w-64">
            Hver stein i grunnmuren ble båret av en av oss. Hver bjelke ble målt med et felles
            latter. Vi er ikke håndverkere — vi er naboer som vever oss inn i landet.
          </p>
          <div class="w-10 h-px bg-secondary/30 mb-6"></div>
          <div class="font-sketch text-xl text-secondary leading-relaxed">
            Mathias, Marie,<br/>Ayla & Andreas
          </div>
        </div>
      </div>
    </section>

    <!-- Fundraiser Section -->
    <section class="mb-24 relative overflow-hidden">
      <div
        class="rounded-sm p-8 md:p-16 relative"
        style="background: linear-gradient(135deg, #fdf6e3 0%, #fef3cd 50%, #fdf0c2 100%); border: 1px solid rgba(123, 88, 30, 0.15); box-shadow: 0 20px 60px rgba(0,0,0,0.08), inset 0 1px 0 rgba(255,255,255,0.9);"
      >
        <!-- Top rule -->
        <div class="flex items-center gap-4 mb-10">
          <div class="flex-1 h-px bg-secondary/20"></div>
          <span class="font-sketch text-secondary/60 text-sm tracking-widest uppercase">Støtt prosjektet</span>
          <div class="flex-1 h-px bg-secondary/20"></div>
        </div>

        <div class="max-w-xl mx-auto text-center">
          <h2 class="font-headline text-4xl md:text-5xl italic text-primary mb-4 leading-tight">
            Bli en del av<br/>historien
          </h2>
          <p class="font-body text-base text-tertiary mb-8 leading-relaxed">
            Vi samler inn midler til å fullføre kapellet. Hver krone går direkte til
            materialer og arbeid. Støtt drømmen vår!
          </p>

          <!-- Fake progress bar -->
          <div class="mb-8">
            <div class="text-center mb-4">
              <div class="font-sketch text-5xl md:text-6xl text-primary font-bold leading-none mb-1">400 000 kr</div>
              <div class="font-label text-xs uppercase tracking-widest text-secondary/70">innsamlet mål</div>
            </div>
            <div class="flex justify-between font-sketch text-base text-secondary mb-2">
              <span>Innsamlet så langt</span>
              <span>100%</span>
            </div>
            <div class="h-3 bg-secondary/10 rounded-full overflow-hidden border border-secondary/10">
              <div
                class="h-full bg-gradient-to-r from-secondary to-primary rounded-full transition-all"
                style="width: 100%;"
              ></div>
            </div>
          </div>

          <a
            target="_blank"
            href="https://www.spleis.no/project/485151?s=c"
            class="inline-flex items-center gap-3 bg-primary text-on-primary px-10 py-4 rounded-sm font-label text-sm hover:bg-primary/90 shadow-lg transition-colors tracking-wide"
          >
            Gi en gave
            <span class="material-symbols-outlined text-base">favorite</span>
          </a>
        </div>

        <!-- Bottom rule -->
        <div class="flex items-center gap-4 mt-10">
          <div class="flex-1 h-px bg-secondary/20"></div>
          <span class="font-sketch text-secondary/40 text-xl">✦</span>
          <div class="flex-1 h-px bg-secondary/20"></div>
        </div>
      </div>
    </section>

  </main>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import veibeskrivelse1 from "@assets/veibeskrivelse1.jpeg";
import veibeskrivelse2 from "@assets/veibeskrivelse2.jpeg";
import { content, defaultLang } from "../../i18n/content";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "no" } },
  ];
}

const { lang } = Astro.params as { lang: string };
const c = lang in content ? content[lang as keyof typeof content] : content[defaultLang];
const bv = c.besokende;
const basePath = "/capellareginaenorvegiae";
---

<Layout title={bv.title} description={bv.metaDescription}>
  <main id="main-content" class="pb-24">

    <section class="pt-16 md:pt-24 px-4 sm:px-8">
      <div class="max-w-3xl mx-auto">
        <h1 class="font-headline text-4xl md:text-5xl italic text-primary leading-tight mb-6">
          {bv.heading}
        </h1>
        <div class="w-16 h-px bg-secondary/40 mb-6"></div>
        <p class="font-body text-lg text-on-surface-variant leading-relaxed max-w-xl">
          {bv.intro}
        </p>
      </div>
    </section>

    <!-- Rules -->
    <section class="px-4 sm:px-8 mt-12">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-headline text-2xl italic text-primary mb-4">{bv.rulesHeading}</h2>
        <ul class="space-y-3 text-on-surface-variant leading-relaxed">
          {bv.rules.map((rule) => (
            <li class="flex gap-3">
              <span class="material-symbols-outlined text-secondary text-xl shrink-0 mt-0.5" aria-hidden="true">check_circle</span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Welcome message -->
    <section class="px-4 sm:px-8 mt-12">
      <div class="max-w-3xl mx-auto">
        <p class="text-on-surface-variant leading-relaxed">{bv.welcome}</p>
      </div>
    </section>

    <!-- Catholic note -->
    <section class="px-4 sm:px-8 mt-8">
      <div class="max-w-3xl mx-auto">
        <p class="text-on-surface-variant leading-relaxed italic">{bv.catholic}</p>
      </div>
    </section>

    <!-- Mass section -->
    <section class="px-4 sm:px-8 mt-12">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-headline text-2xl italic text-primary mb-4">{bv.massHeading}</h2>
        <ul class="space-y-3 text-on-surface-variant leading-relaxed">
          {bv.massRules.map((rule) => (
            <li class="flex gap-3">
              <span class="material-symbols-outlined text-secondary text-xl shrink-0 mt-0.5" aria-hidden="true">church</span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Images -->
    <section class="px-4 sm:px-8 mt-16">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-8">
          <a
            href="https://maps.app.goo.gl/g5WxkXWGwMw9pADD6"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 min-h-[44px] px-8 py-2.5 bg-primary text-on-primary rounded-sm font-label text-sm hover:bg-primary/90 transition-colors shadow-md tracking-wide"
          >
            <span class="material-symbols-outlined text-base" aria-hidden="true">map</span>
            {lang === 'no' ? 'Åpne i Google Maps' : 'Open in Google Maps'}
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
          <figure class="overflow-hidden rounded-2xl shadow-2xl">
            <button
              type="button"
              class="group relative block w-full overflow-hidden cursor-zoom-in"
              data-lightbox-btn
              aria-label={`${bv.zoomLabel}: ${bv.img1Alt}`}
            >
              <Image src={veibeskrivelse1} alt={bv.img1Alt} class="w-full h-auto transition-transform duration-300 group-hover:scale-[1.03]" />
              <span class="absolute inset-0 bg-black/0 group-hover:bg-black/25 group-focus-visible:bg-black/25 transition-colors" aria-hidden="true"></span>
              <span class="absolute top-3 right-3 w-9 h-9 rounded-full bg-black/55 text-white grid place-items-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity" aria-hidden="true">
                <span class="material-symbols-outlined text-lg">zoom_in</span>
              </span>
            </button>
            <figcaption class="py-3 px-4 text-center text-sm text-on-surface/70 font-body bg-surface-container-low">
              {bv.img1Caption}
            </figcaption>
          </figure>
          <figure class="overflow-hidden rounded-2xl shadow-2xl">
            <button
              type="button"
              class="group relative block w-full overflow-hidden cursor-zoom-in"
              data-lightbox-btn
              aria-label={`${bv.zoomLabel}: ${bv.img2Alt}`}
            >
              <Image src={veibeskrivelse2} alt={bv.img2Alt} class="w-full h-auto transition-transform duration-300 group-hover:scale-[1.03]" />
              <span class="absolute inset-0 bg-black/0 group-hover:bg-black/25 group-focus-visible:bg-black/25 transition-colors" aria-hidden="true"></span>
              <span class="absolute top-3 right-3 w-9 h-9 rounded-full bg-black/55 text-white grid place-items-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity" aria-hidden="true">
                <span class="material-symbols-outlined text-lg">zoom_in</span>
              </span>
            </button>
            <figcaption class="py-3 px-4 text-center text-sm text-on-surface/70 font-body bg-surface-container-low">
              {bv.img2Caption}
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <div class="text-center mt-16">
      <a
        href={`${basePath}/${lang}`}
        class="inline-flex items-center gap-2 min-h-[44px] px-8 font-label text-sm text-primary hover:text-primary/70 transition-colors tracking-wide"
      >
        <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
        {bv.backText}
      </a>
    </div>

  </main>

  <!-- Lightbox -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label={bv.zoomLabel}
  >
    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 z-10 w-12 h-12 rounded-full bg-black/60 text-white grid place-items-center hover:bg-black/80 transition-colors"
      aria-label={bv.zoomClose}
    >
      <span class="material-symbols-outlined text-2xl">close</span>
    </button>
    <img id="lightbox-img" class="max-h-[88vh] max-w-full object-contain rounded-lg shadow-2xl" alt="" />
    <span id="lightbox-caption" class="absolute bottom-5 left-1/2 -translate-x-1/2 text-white/90 text-sm font-body max-w-[90%] text-center bg-black/45 px-4 py-1.5 rounded-full"></span>
  </div>

  <script is:inline>
    const lb = document.getElementById("lightbox");
    const lbImg = document.getElementById("lightbox-img");
    const lbCap = document.getElementById("lightbox-caption");
    const lbClose = document.getElementById("lightbox-close");
    if (lb && lbImg && lbClose) {
      let lastFocused = null;
      const focusable = () =>
        Array.from(lb.querySelectorAll('button, [href], img[alt]')).filter(
          (el) => el.getBoundingClientRect().width > 0 && el.getBoundingClientRect().height > 0
        );
      const openLb = (img) => {
        lastFocused = document.activeElement;
        lbImg.src = img.src;
        lbImg.alt = "";
        if (lbCap) lbCap.textContent = img.alt || "";
        lb.classList.remove("hidden");
        lb.classList.add("flex");
        lb.setAttribute("aria-hidden", "false");
        document.getElementById("main-content")?.setAttribute("inert", "");
        document.querySelector("header")?.setAttribute("inert", "");
        document.querySelector("footer")?.setAttribute("inert", "");
        lbClose.focus();
      };
      const closeLb = () => {
        lb.classList.add("hidden");
        lb.classList.remove("flex");
        lb.setAttribute("aria-hidden", "true");
        document.getElementById("main-content")?.removeAttribute("inert");
        document.querySelector("header")?.removeAttribute("inert");
        document.querySelector("footer")?.removeAttribute("inert");
        if (lastFocused && document.contains(lastFocused)) lastFocused.focus();
      };
      document.querySelectorAll("[data-lightbox-btn]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const img = btn.querySelector("img");
          if (img) openLb(img);
        });
      });
      lbClose.addEventListener("click", closeLb);
      lb.addEventListener("click", (e) => {
        if (e.target === lb) closeLb();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeLb();
        if (e.key === "Tab" && lb.getAttribute("aria-hidden") === "false") {
          const els = focusable();
          if (!els.length) return;
          const first = els[0];
          const last = els[els.length - 1];
          const active = document.activeElement;
          if (e.shiftKey && (active === first || active === lb)) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && active === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }
  </script>
</Layout>

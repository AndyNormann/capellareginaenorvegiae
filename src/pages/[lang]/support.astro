---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import vippsQr from "@assets/capella_vipps_qr.png";
import { content, defaultLang } from "../../i18n/content";
import { fetchDonationData, formatKr } from "../../lib/vipps";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "no" } },
  ];
}

const { lang } = Astro.params as { lang: string };
const c = lang in content ? content[lang as keyof typeof content] : content[defaultLang];
const sp = c.support;

const donationData = await fetchDonationData();
const totalRaised = formatKr(donationData.totalRaisedSats, lang);
const basePath = "/capellareginaenorvegiae";

function formatDate(iso: string, lang: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString(lang === "no" ? "nb-NO" : "en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<Layout title={sp.title} description={sp.metaDescription}>
  <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-8 pb-24">

    <section class="pt-16 pb-12 md:pt-24 md:pb-16 text-center">
      <h1 class="font-headline text-4xl md:text-5xl italic text-primary leading-tight mb-6">
        {sp.heading}
      </h1>
      <div class="w-16 h-px bg-secondary/40 mx-auto mb-6"></div>
      <p class="font-body text-lg text-on-surface-variant leading-relaxed max-w-xl mx-auto">
        {sp.body}
      </p>
    </section>

    <section aria-label={sp.heading} class="mb-16">
      <div class="fundraiser-panel">
        <div class="max-w-xl mx-auto text-center">

          <!-- Raised amount -->
          <div class="mb-10">
            <div class="font-sketch text-5xl md:text-6xl text-primary font-bold leading-none mb-1">{totalRaised}</div>
            <div class="font-label text-xs uppercase tracking-widest text-secondary">{sp.raisedLabel}</div>
            {donationData.lastUpdated && (
              <div class="font-label text-xs text-on-surface-variant mt-2">
                {sp.updatedLabel} {formatDate(donationData.lastUpdated, lang)}
              </div>
            )}
          </div>

          <!-- Vipps QR code -->
          <div class="flex flex-col items-center gap-3">
            <span class="font-label text-xs uppercase tracking-widest text-secondary">{sp.vippsPrompt}</span>
            <Image src={vippsQr} alt={sp.vippsQrAlt} class="w-32 h-32 md:w-40 md:h-40" />
          </div>

          {donationData.topDonors.length > 0 && (
            <div class:list={[
              "mt-12 w-full grid gap-8 text-left",
              donationData.recentDonors.length > 0 ? "grid-cols-1 md:grid-cols-2" : "grid-cols-1",
            ]}>
              <!-- Top donors -->
              <div>
                <h2 class="font-headline text-lg italic text-primary mb-3">{sp.topDonorsLabel}</h2>
                <div class="space-y-1">
                  {donationData.topDonors.slice(0, 10).map((donor) => (
                    <div class="flex justify-between items-center py-1.5 border-b border-secondary/10">
                      <div class="flex flex-col min-w-0">
                        <span class="font-body text-xs text-on-surface truncate">
                          {donor.source === 'vipps' ? sp.anonymousLabel : donor.name}
                        </span>
                        {donor.message && (
                          <span class="font-body text-xs text-on-surface-variant italic truncate leading-snug block min-w-0">"{donor.message}"</span>
                        )}
                      </div>
                      <span class="font-sketch text-sm text-primary font-bold whitespace-nowrap ml-3">{formatKr(donor.amountSats, lang)}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Recent activity -->
              {donationData.recentDonors.length > 0 && (
                <div>
                  <h2 class="font-headline text-lg italic text-primary mb-3">{sp.recentActivityLabel}</h2>
                  <div class="space-y-1">
                    {donationData.recentDonors.slice(0, 10).map((donor) => (
                      <div class="flex justify-between items-center py-1.5 border-b border-secondary/10">
                        <div class="flex flex-col min-w-0">
                          <span class="font-body text-xs text-on-surface truncate">
                            {donor.source === 'vipps' ? sp.anonymousLabel : donor.name}
                          </span>
                          {donor.message && (
                            <span class="font-body text-xs text-on-surface-variant italic truncate leading-snug block min-w-0">"{donor.message}"</span>
                          )}
                        </div>
                        <span class="font-sketch text-sm text-primary font-bold whitespace-nowrap ml-3">{formatKr(donor.amountSats, lang)}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}

          <!-- Bottom rule -->
          <div class="flex items-center gap-4 mt-10">
            <div class="flex-1 h-px bg-secondary/20"></div>
            <span class="material-symbols-outlined text-secondary/40 text-xl" aria-hidden="true">church</span>
            <div class="flex-1 h-px bg-secondary/20"></div>
          </div>

        </div>
      </div>
    </section>

    <div class="text-center">
      <a
        href={`${basePath}/${lang}/plans`}
        class="inline-flex items-center gap-2 min-h-[44px] px-8 mb-6 font-label text-sm text-primary hover:text-primary/70 transition-colors tracking-wide"
      >
        <span class="material-symbols-outlined text-base" aria-hidden="true">straighten</span>
        {sp.whatItBuilds}
      </a>
      <div>
        <a
          href={`${basePath}/${lang}`}
          class="inline-flex items-center gap-2 min-h-[44px] px-8 font-label text-sm text-primary hover:text-primary/70 transition-colors tracking-wide"
        >
          <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
          {sp.backText}
        </a>
      </div>
    </div>

  </main>
</Layout>

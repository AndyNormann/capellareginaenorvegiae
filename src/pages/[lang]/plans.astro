---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import apsis1 from "@assets/plan-drawings/clean/apseMain.jpg";
import scale1 from "@assets/plan-drawings/clean/scale1.jpg";
import scale2 from "@assets/plan-drawings/clean/scale2.jpg";
import scale3 from "@assets/plan-drawings/clean/scale3.jpg";
import scale4 from "@assets/plan-drawings/clean/scale4.jpg";
import scale5 from "@assets/plan-drawings/clean/scale5.jpg";
import glassmaleriImg from "@assets/glassmaleri.jpg";
import clockImg from "@assets/clock.jpg";
import plan3d from "@assets/plan-drawings/clean/plan3d.mp4";
import HotspotImage from "../../components/HotspotImage.astro";
import { content, defaultLang } from "../../i18n/content";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: string };
const c = lang in content ? content[lang as keyof typeof content] : content[defaultLang];
const pl = c.plans;


const imageGroups: Record<string, { src: typeof apsis1; alt: string }[]> = {
  apsis: [
    { src: apsis1, alt: pl.imgAlts.apseMain },
  ],
  scale: [
    { src: scale1, alt: pl.imgAlts.scale1 },
    { src: scale2, alt: pl.imgAlts.scale2 },
    { src: scale3, alt: pl.imgAlts.scale3 },
    { src: scale4, alt: pl.imgAlts.scale4 },
    { src: scale5, alt: pl.imgAlts.scale5 },
  ],
};
---

<Layout title={pl.title} description={pl.metaDescription}>
  <main id="main-content" class="pb-24">

    <!-- Header -->
    <section class="pt-16 md:pt-24 px-4 sm:px-8 reveal">
      <div class="max-w-3xl mx-auto">
        <h1 class="font-headline text-4xl md:text-5xl italic text-primary leading-tight mb-6">
          {pl.heading}
        </h1>
        <div class="w-16 h-px bg-secondary/40 mb-6"></div>
        <p class="font-body text-lg text-on-surface-variant leading-relaxed max-w-xl">
          {pl.intro}
        </p>
      </div>
    </section>

    <!-- Video -->
    <section class="px-4 sm:px-8">
      <div class="max-w-3xl mx-auto mt-16">
        <div class="max-w-3xl mx-auto">
          <iframe
            src="https://www.youtube-nocookie.com/embed/OPFI60a49Fs"
            title="Video from Mariaslæen"
            class="w-full aspect-video rounded-2xl shadow-xl"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <!-- Body blocks -->
    {pl.blocks.map((block, i) => (
      <Fragment>
      <section class="px-4 sm:px-8">
        <div class="max-w-3xl mx-auto mt-16">
          <div class="flex items-center gap-3 mb-6">
            {block.icon && (
              <span class="material-symbols-outlined text-secondary text-2xl" aria-hidden="true">{block.icon}</span>
            )}
            <h2 class="font-headline text-3xl italic text-primary leading-snug">{block.heading}</h2>
          </div>

          <div class="space-y-4 text-on-surface-variant leading-relaxed">
            {block.paragraphs && block.paragraphs.map((para, pidx) => (
              <p>
                {Array.isArray(para)
                  ? para.map((seg, sidx) =>
                      typeof seg === "string"
                        ? seg
                        : <a key={sidx} href={seg.href} target="_blank" rel="noopener" class="text-primary underline underline-offset-2 hover:text-primary/80">{seg.text}</a>
                    )
                  : para}
              </p>
            ))}
          </div>

          {block.list && (
            <ul class="mt-6 space-y-3 text-on-surface-variant leading-relaxed">
              {block.list.map((item) => (
                <li class="flex gap-3">
                  <span class="material-symbols-outlined text-secondary text-xl shrink-0 mt-0.5" aria-hidden="true">arrow_forward</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}

          {block.amounts && (
            <dl class="mt-6 divide-y divide-outline-variant border border-outline-variant rounded-xl overflow-hidden bg-surface-container-low">
              {block.amounts.map((row) => (
                <div class="flex items-center justify-between gap-4 px-5 py-4">
                  <dt class="font-body text-on-surface-variant">{row.label}</dt>
                  <dd class="font-headline italic text-xl text-primary shrink-0">{row.value}</dd>
                </div>
              ))}
            </dl>
          )}

          {block.images && (
            <div class:list={[
              "mt-8 grid gap-4 md:gap-6",
              block.images === "scale"
                ? "grid-cols-2 md:grid-cols-3"
                : block.images === "apsis"
                ? "grid-cols-1"
                : "grid-cols-1 sm:grid-cols-2",
            ]}>
              {imageGroups[block.images].map((img) => (
                <button
                  type="button"
                  class="group relative block w-full overflow-hidden rounded-2xl shadow-xl cursor-zoom-in"
                  data-lightbox-btn
                  aria-label={`${pl.zoomLabel}: ${img.alt}`}
                >
                  <Image
                    src={img.src}
                    alt={img.alt}
                    class:list={[
                      "w-full transition-transform duration-300 group-hover:scale-[1.03]",
                      block.images === "scale" ? "aspect-[3/4] object-contain bg-surface-container-low" : "object-cover",
                    ]}
                  />
                  <span class="absolute inset-0 bg-black/0 group-hover:bg-black/25 group-focus-visible:bg-black/25 transition-colors" aria-hidden="true"></span>
                  <span class="absolute top-3 right-3 w-9 h-9 rounded-full bg-black/55 text-white grid place-items-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity" aria-hidden="true">
                    <span class="material-symbols-outlined text-lg" aria-hidden="true">zoom_in</span>
                  </span>
                </button>
              ))}
            </div>
          )}

          {/* 3D video, alongside the apsis pictures */}
          {block.images === "apsis" && (
            <div class="mt-6">
              <video
                src={plan3d}
                controls
                preload="metadata"
                playsInline
                aria-label={lang === 'no' ? '3D-plan over kapellet' : '3D floor plan of the chapel'}
                class="w-full h-auto rounded-2xl shadow-xl"
              />
            </div>
          )}
        </div>
      </section>

      {/* Stained-glass section, right after the roof-structure block */}
      {i === 3 && pl.glass && (
        <section class="px-4 sm:px-8">
          <div class="max-w-3xl mx-auto mt-16">
            <div class="flex items-center gap-3 mb-6">
              <span class="material-symbols-outlined text-secondary text-2xl" aria-hidden="true">church</span>
              <h2 class="font-headline text-3xl italic text-primary leading-snug">{pl.glass.heading}</h2>
            </div>
            <p class="text-on-surface-variant leading-relaxed">
              {Array.isArray(pl.glass.paragraph)
                ? pl.glass.paragraph.map((seg, sidx) =>
                    typeof seg === "string"
                      ? seg
                      : <a key={sidx} href={seg.href} target="_blank" rel="noopener" class="text-primary underline underline-offset-2 hover:text-primary/80">{seg.text}</a>
                  )
                : pl.glass.paragraph}
            </p>
            <HotspotImage
              src={glassmaleriImg}
              alt={pl.glass.alt}
              class="rounded-2xl shadow-xl mt-8"
              hotspots={pl.glass.hotspots}
            />
          </div>
        </section>
      )}

      {/* Clock section, right after the stained-glass block */}
      {i === 3 && pl.clock && (
        <section class="px-4 sm:px-8">
          <div class="max-w-3xl mx-auto mt-16">
            <div class="flex items-center gap-3 mb-6">
              <span class="material-symbols-outlined text-secondary text-2xl" aria-hidden="true">schedule</span>
              <h2 class="font-headline text-3xl italic text-primary leading-snug">{pl.clock.heading}</h2>
            </div>
            {pl.clock.paragraph && <p class="text-on-surface-variant leading-relaxed">{pl.clock.paragraph}</p>}
            <Image src={clockImg} alt={pl.clock.alt} class="w-full h-auto rounded-2xl shadow-xl mt-8 object-cover" />
          </div>
        </section>
      )}
      </Fragment>
    ))}

    <!-- CTA -->
    <section class="px-4 sm:px-8 mt-16 pb-24 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="font-headline italic text-2xl text-primary mb-2 leading-snug">{pl.cta.heading}</p>
        <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed max-w-md mx-auto">
          {pl.cta.body}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={`/${lang}/support`}
            class="inline-flex items-center gap-3 min-h-[44px] px-8 py-2.5 bg-primary text-on-primary rounded-sm font-label text-sm hover:bg-primary/90 shadow-lg transition-colors tracking-wide"
          >
            {pl.cta.button}
            <span class="material-symbols-outlined text-base" aria-hidden="true">favorite</span>
          </a>
          <a
            href={`/${lang}`}
            class="inline-flex items-center gap-2 min-h-[44px] px-8 py-2.5 border border-primary/30 text-primary rounded-sm font-label text-sm hover:bg-primary/5 transition-colors tracking-wide"
          >
            <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
            {pl.cta.backText}
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- Lightbox: click a sketch to view it larger -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label={pl.zoomLabel}
  >
    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 z-10 w-12 h-12 rounded-full bg-black/60 text-white grid place-items-center hover:bg-black/80 transition-colors"
      aria-label={pl.zoomClose}
    >
      <span class="material-symbols-outlined text-2xl">close</span>
    </button>
    <img id="lightbox-img" class="max-h-[88vh] max-w-full object-contain rounded-lg shadow-2xl" alt="" aria-describedby="lightbox-caption" />
    <span id="lightbox-caption" class="absolute bottom-5 left-1/2 -translate-x-1/2 text-white/90 text-sm font-body max-w-[90%] text-center bg-black/45 px-4 py-1.5 rounded-full"></span>
  </div>

  <script is:inline>
    const lb = document.getElementById("lightbox");
    const lbImg = document.getElementById("lightbox-img");
    const lbCap = document.getElementById("lightbox-caption");
    const lbClose = document.getElementById("lightbox-close");
    if (lb && lbImg && lbClose) {
      let lastFocused = null;

      const focusable = () =>
        Array.from(lb.querySelectorAll<HTMLElement>('button, [href], img[alt]')).filter(
          (el) => el.getBoundingClientRect().width > 0 && el.getBoundingClientRect().height > 0
        );

      const openLb = (img) => {
        lastFocused = document.activeElement;
        lbImg.src = img.src;
        lbImg.alt = img.alt || "";
        if (lbCap) lbCap.textContent = img.alt || "";
        lb.classList.remove("hidden");
        lb.classList.add("flex");
        lb.setAttribute("aria-hidden", "false");
        document.getElementById("main-content")?.setAttribute("inert", "");
        document.querySelector("header")?.setAttribute("inert", "");
        document.querySelector("footer")?.setAttribute("inert", "");
        lbClose.focus();
      };
      const closeLb = () => {
        lb.classList.add("hidden");
        lb.classList.remove("flex");
        lb.setAttribute("aria-hidden", "true");
        document.getElementById("main-content")?.removeAttribute("inert");
        document.querySelector("header")?.removeAttribute("inert");
        document.querySelector("footer")?.removeAttribute("inert");
        if (lastFocused && document.contains(lastFocused)) lastFocused.focus();
      };
      document.querySelectorAll("[data-lightbox-btn]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const img = btn.querySelector("img");
          if (img) openLb(img);
        });
      });
      lbClose.addEventListener("click", closeLb);
      lb.addEventListener("click", (e) => {
        if (e.target === lb) closeLb();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeLb();
        if (e.key === "Tab" && lb.getAttribute("aria-hidden") === "false") {
          const els = focusable();
          if (!els.length) return;
          const first = els[0];
          const last = els[els.length - 1];
          const active = document.activeElement;
          if (e.shiftKey && (active === first || active === lb)) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && active === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }
  </script>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import HotspotImage from "../../components/HotspotImage.astro";
import ourLadyImg from "@assets/closeupourlady.jpg";
import varfrueImg from "@assets/varfrue.jpg";
import { content, defaultLang } from "../../i18n/content";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: string };
const c = lang in content ? content[lang as keyof typeof content] : content[defaultLang];
const ol = c.ourlady;

---

<Layout title={ol.title} description={ol.metaDescription}>
  <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-8 pb-24">

    <!-- Header: the dedication -->
    <section class="pt-16 md:pt-24 text-center">
      <h1 class="font-headline text-4xl md:text-5xl italic text-primary leading-tight mb-6">
        {ol.heading}
      </h1>
      <div class="w-16 h-px bg-secondary/40 mx-auto mb-6"></div>
      <p class="font-body text-lg text-on-surface-variant leading-relaxed max-w-xl mx-auto">
        {ol.intro}
      </p>
    </section>

    <!-- The story, and the image -->
    <section class="max-w-5xl mx-auto">
      {ol.blocks.map((block, i) => (
        <div class="mt-16">
          {block.heading && (
            <div class="flex items-center justify-center gap-3 mb-6">
              <h2 class="font-headline text-3xl italic text-primary leading-snug text-center">
                {block.heading}
              </h2>
            </div>
          )}
          <div class="max-w-2xl mx-auto space-y-4 text-on-surface-variant leading-relaxed text-center">
            {block.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
          </div>

          {/* Images sit between the first and second block */}
          {i === 0 && (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-start mt-12">
              <figure class="md:col-span-7">
                <HotspotImage
                  src={varfrueImg}
                  alt={ol.mainImageAlt}
                  class="rounded-2xl shadow-xl"
                  hotspots={ol.hotspots}
                />
                <figcaption class="mt-3 font-body text-xs text-on-surface-variant italic text-center">
                  {ol.artistCredit}
                </figcaption>
              </figure>
              <div class="md:col-span-5 md:mt-16">
                <Image
                  src={ourLadyImg}
                  alt={ol.imageAlt}
                  class="w-full aspect-[2/3] object-cover rounded-2xl shadow-xl"
                />
              </div>
            </div>
          )}
        </div>
      ))}
    </section>

    <div class="text-center mt-16">
      <div class="flex flex-wrap justify-center gap-4 mb-8">
        <a
          href={`/${lang}/support`}
          class="inline-flex items-center gap-2 min-h-[44px] px-8 py-2.5 bg-primary text-on-primary rounded-sm font-label text-sm hover:bg-primary/90 transition-colors shadow-md tracking-wide"
        >
          <span class="material-symbols-outlined text-base" aria-hidden="true">favorite</span>
          {ol.supportButton}
        </a>
        <a
          href={`/${lang}/story`}
          class="inline-flex items-center gap-2 min-h-[44px] px-8 py-2.5 border border-primary/40 text-primary rounded-sm font-label text-sm hover:bg-primary/5 transition-colors tracking-wide"
        >
          {ol.storyLink}
          <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
      <a
        href={`/${lang}`}
        class="inline-flex items-center gap-2 min-h-[44px] px-8 font-label text-sm text-primary hover:text-primary/70 transition-colors tracking-wide"
      >
        <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
        {ol.backText}
      </a>
    </div>

  </main>
</Layout>

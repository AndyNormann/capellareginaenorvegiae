---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import before from '@assets/before.jpeg';
import after from '@assets/after.jpeg';
import alleFire from '@assets/alle_fire.jpg';
import klem from '@assets/klem.jpg';
import { content, defaultLang } from '../../i18n/content';

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "no" } },
  ];
}

const { lang } = Astro.params as { lang: string };
const c = lang in content ? content[lang as keyof typeof content] : content[defaultLang];
const st = c.story;
const sections = st.sections;
---

<Layout>
  <main class="max-w-3xl mx-auto px-4 sm:px-8 pb-24">

    <!-- Page header -->
    <section class="pt-16 pb-12 md:pt-24 md:pb-16 reveal">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 bg-secondary-container text-on-secondary-container rounded-full font-label text-xs uppercase tracking-[0.2em]">
        <span class="w-1.5 h-1.5 rounded-full bg-secondary inline-block"></span>
        {st.badge}
      </div>
      <h1 class="font-headline text-5xl md:text-7xl italic text-primary leading-tight mb-6">
        {st.heading}
      </h1>
      <div class="w-16 h-px bg-secondary/40 mb-6"></div>
      <p class="font-body text-lg text-on-surface-variant leading-relaxed max-w-xl">
        {st.intro}
      </p>
    </section>

    <!-- Story content card -->
    <article class="bg-surface-bright/90 backdrop-blur-md rounded-2xl shadow-2xl border border-on-surface/8 overflow-hidden reveal reveal-delay-1">

      {sections.map((section, i) => (
        <div class="p-8 md:p-12">
          <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-secondary text-2xl">{section.icon}</span>
            <h2 class="font-headline text-3xl italic text-primary leading-snug">{section.heading}</h2>
          </div>
          <div class:list={[
            "space-y-4 text-on-surface-variant leading-relaxed",
            i === 0 ? "prose-custom" : "",
          ]}>
            {section.body.map((para) => (
              <p>{para}</p>
            ))}
          </div>

          {/* Group photo grid — after "The four of us" section (index 2) */}
          {i === 2 && (
            <div class="mt-8 grid grid-cols-2 gap-3">
              <div class="overflow-hidden rounded-sm">
                <Image src={alleFire} alt={st.alleFireAlt} class="w-full h-48 md:h-64 object-cover" />
              </div>
              <div class="overflow-hidden rounded-sm">
                <Image src={klem} alt={st.klemAlt} class="w-full h-48 md:h-64 object-cover" />
              </div>
            </div>
          )}

          {/* Before/after grid — after "What we've done so far" section (index 3) */}
          {i === 3 && (
            <div class="mt-8 grid grid-cols-2 gap-3">
              <div class="overflow-hidden rounded-sm">
                <Image src={before} alt={st.beforeAlt} class="w-full h-40 md:h-56 object-cover" />
                <p class="text-xs font-label text-on-surface-variant mt-1 uppercase tracking-wider">{st.beforeLabel}</p>
              </div>
              <div class="overflow-hidden rounded-sm">
                <Image src={after} alt={st.afterAlt} class="w-full h-40 md:h-56 object-cover" />
                <p class="text-xs font-label text-on-surface-variant mt-1 uppercase tracking-wider">{st.afterLabel}</p>
              </div>
            </div>
          )}
        </div>
      ))}

      <!-- CTA -->
      <div class="p-8 md:p-12 text-center">
        <p class="font-headline italic text-2xl text-primary mb-2 leading-snug">{st.cta.heading}</p>
        <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed max-w-md mx-auto">
          {st.cta.body}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            target="_blank"
            href="https://www.spleis.no/project/485151?s=c"
            class="btn-pulse inline-flex items-center gap-3 bg-primary text-on-primary px-8 py-3.5 rounded-sm font-label text-sm hover:bg-primary/90 shadow-lg transition-colors tracking-wide"
          >
            {st.cta.button}
            <span class="material-symbols-outlined text-base">favorite</span>
          </a>
          <a
            href={`/capellareginaenorvegiae/${lang}`}
            class="inline-flex items-center gap-2 px-8 py-3.5 border border-primary/30 text-primary rounded-sm font-label text-sm hover:bg-primary/5 transition-colors tracking-wide"
          >
            <span class="material-symbols-outlined text-base">arrow_back</span>
            {st.cta.backText}
          </a>
        </div>
      </div>

    </article>

  </main>
</Layout>
---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import before from '@assets/before.jpeg';
import after from '@assets/afterv2-1.jpg';
import alleFire from '@assets/alle_fire.jpg';
import matheaImg from '@assets/matheabaadsto.jpg';
import sigridMesseImg from '@assets/messe_sigrid_undset.jpg';
import { content, defaultLang } from '../../i18n/content';

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "no" } },
  ];
}

const { lang } = Astro.params as { lang: string };
const c = lang in content ? content[lang as keyof typeof content] : content[defaultLang];
const st = c.story;
const sections = st.sections;
---

<Layout description={st.metaDescription}>
  <main id="main-content" class="pb-24">

    <!-- Page header -->
    <section class="pt-16 md:pt-24 px-4 sm:px-8 reveal">
      <div class="max-w-3xl mx-auto">
        <h1 class="font-headline text-4xl md:text-5xl italic text-primary leading-tight mb-6">
          {st.heading}
        </h1>
        <div class="w-16 h-px bg-secondary/40 mb-6"></div>
        <p class="font-body text-lg text-on-surface-variant leading-relaxed max-w-xl">
          {st.intro}
        </p>

        {/* The before/after proof, right under the intro */}
        <div class="mt-10 max-w-4xl">
          <div class="rounded-2xl shadow-2xl">
            <BeforeAfterSlider
              before={before}
              after={after}
              ariaLabel={st.slider.ariaLabel}
              beforeLabel={st.slider.beforeLabel}
              afterLabel={st.slider.afterLabel}
              alt=""
            />
          </div>
          <p id="slider-hint" class="font-sketch text-base text-tertiary mt-3 px-1">{st.slider.hint}</p>
        </div>
      </div>
    </section>

    <!-- Story bands: text stays in the reading column, construction
         imagery breaks wide — the construction photos carry the arc. -->
    {sections.map((section, i) => (
      <section class="px-4 sm:px-8">
        <div class:list={[
          "mx-auto mt-16",
          i === 1 ? "max-w-5xl" : "max-w-xl",
        ]}>
          <div class:list={[i === 1 ? "max-w-xl" : ""]}>
            <div class="flex items-center gap-3 mb-6">
              <span class="material-symbols-outlined text-secondary text-2xl" aria-hidden="true">{section.icon}</span>
              <h2 class="font-headline text-3xl italic text-primary leading-snug">{section.heading}</h2>
            </div>
            <div class:list={[
              "space-y-4 text-on-surface-variant leading-relaxed",
              i === 0 ? "prose-custom" : "",
            ]}>
              {section.body.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </div>

          {/* Video after the vision section */}
          {i === 1 && (
            <div class="mt-10">
              <div class="max-w-3xl mx-auto">
                <iframe
                  src="https://www.youtube-nocookie.com/embed/XP0STOoy0-8"
                  title="Video from Mariaslæen"
                  class="w-full aspect-video rounded-2xl shadow-xl"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          )}

          {/* Alle fire — construction photo, below the name section */}
          {i === 2 && (
            <figure class="mt-10">
              <div class="overflow-hidden rounded-2xl shadow-2xl">
                <Image src={alleFire} alt={st.alleFireAlt} class="w-full aspect-[4/3] object-cover" />
              </div>
              <figcaption class="mt-3 text-center text-sm text-on-surface/70 font-body bg-surface-container-low py-2 px-4">
                {st.alleFireCaption}
              </figcaption>
            </figure>
          )}

          {/* Mathea Baadstø photo, below the background section */}
          {i === 3 && (
            <figure class="mt-10">
              <div class="overflow-hidden rounded-2xl shadow-2xl">
                <Image src={matheaImg} alt={st.matheaAlt} class="w-full h-auto" />
              </div>
              <figcaption class="mt-3 text-center text-sm text-on-surface/70 font-body">
                {st.matheaCaption}
              </figcaption>
            </figure>
            <figure class="mt-8">
              <div class="overflow-hidden rounded-2xl shadow-2xl">
                <Image src={sigridMesseImg} alt={st.sigridMesseAlt} class="w-full h-auto" />
              </div>
              <figcaption class="mt-3 text-center text-sm text-on-surface/70 font-body">
                {st.sigridMesseCaption}
              </figcaption>
            </figure>
          )}
        </div>
      </section>
    ))}

    <!-- CTA -->
    <section class="px-4 sm:px-8 mt-16 pb-24 text-center">
      <div class="max-w-3xl mx-auto">
        <p class="font-headline italic text-2xl text-primary mb-2 leading-snug">{st.cta.heading}</p>
        <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed max-w-md mx-auto">
          {st.cta.body}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={`/capellareginaenorvegiae/${lang}/support`}
            class="inline-flex items-center gap-3 min-h-[44px] px-8 py-2.5 bg-primary text-on-primary rounded-sm font-label text-sm hover:bg-primary/90 shadow-lg transition-colors tracking-wide"
          >
            {st.cta.button}
            <span class="material-symbols-outlined text-base" aria-hidden="true">favorite</span>
          </a>
          <a
            href={`/capellareginaenorvegiae/${lang}`}
            class="inline-flex items-center gap-2 min-h-[44px] px-8 py-2.5 border border-primary/30 text-primary rounded-sm font-label text-sm hover:bg-primary/5 transition-colors tracking-wide"
          >
            <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
            {st.cta.backText}
          </a>
        </div>
      </div>
    </section>

    {/* Read more */}
    {st.readMore && (
      <section class="px-4 sm:px-8 mt-16 pb-24">
        <div class="max-w-3xl mx-auto">
          <h2 class="font-headline text-3xl italic text-primary leading-snug mb-6">{st.readMore.heading}</h2>
          <ul class="space-y-3 text-on-surface-variant leading-relaxed">
            {st.readMore.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-start gap-2 text-primary underline underline-offset-2 hover:text-primary/80"
                >
                  <span class="material-symbols-outlined text-lg shrink-0 mt-0.5" aria-hidden="true">arrow_outward</span>
                  <span>{link.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { content } from '../i18n/content';
import fs from 'node:fs';
import path from 'node:path';

const lang = "no";
const c = content[lang];
const gl = c.galleri;

// Read the manifest generated by sync-gallery.mjs
const manifestPath = path.resolve('public/assets/gallery/manifest.json');
let images: { src: string; alt: string; modifiedTime: string }[] = [];
if (fs.existsSync(manifestPath)) {
  try {
    images = JSON.parse(fs.readFileSync(manifestPath, 'utf-8'));
  } catch { images = []; }
}

const resolvedImages = images.map((img) => {
  const filename = path.basename(img.src);
  return {
    src: `/assets/gallery/${filename}`,
    alt: img.alt,
  };
}).filter(img => img.src);

const gallerySchema = {
  "@type": "ImageGallery",
  "name": gl.heading,
  "description": gl.metaDescription,
  "about": {
    "@type": "LandmarksOrHistoricalBuildings",
    "name": "Mariaslæen – Capella Reginae Norvegiae"
  }
};
---

<Layout title={gl.title} description={gl.metaDescription} pageSchema={gallerySchema}>
  <main id="main-content" class="pb-24">

    <section class="pt-16 md:pt-24 px-4 sm:px-8 reveal">
      <div class="max-w-6xl mx-auto">
        <h1 class="font-headline text-4xl md:text-5xl italic text-primary leading-tight mb-6">
          {gl.heading}
        </h1>
        <div class="w-16 h-px bg-secondary/40 mb-6"></div>
        <p class="font-body text-lg text-on-surface-variant leading-relaxed max-w-xl">
          {gl.description}
        </p>
      </div>
    </section>

    <section class="px-4 sm:px-8 mt-10 reveal">
      <div class="max-w-6xl mx-auto">
        {resolvedImages.length > 0 ? (
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4" id="gallery-grid">
            {resolvedImages.map((img, i) => (
              <button
                type="button"
                class={`group relative block w-full overflow-hidden rounded-xl cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-primary ${i >= 20 ? 'hidden' : ''}`}
                data-gallery-btn={i}
                data-gallery-item={i}
                aria-label={`Forstør bilde: ${img.alt}`}
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  class="w-full aspect-[4/3] object-cover transition-transform duration-300 group-hover:scale-[1.04]"
                  loading="lazy"
                  width="400"
                  height="300"
                />
                <span class="absolute inset-0 bg-black/0 group-hover:bg-black/20 group-focus-visible:bg-black/20 transition-colors" aria-hidden="true"></span>
              </button>
            ))}
          </div>
        ) : (
          <p class="text-on-surface-variant text-center py-16">Ingen bilder tilgjengelig.</p>
        )}
        <div id="gallery-sentinel" class="h-1"></div>
      </div>
    </section>

    <div class="text-center mt-16 px-4">
      <a
        href="/besokende"
        class="inline-flex items-center gap-2 min-h-[44px] px-8 font-label text-sm text-primary hover:text-primary/70 transition-colors tracking-wide"
      >
        <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
        Tilbake til forsiden
      </a>
    </div>

  </main>

  <!-- Lightbox -->
  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label="Bildgalleri"
  >
    <!-- Close -->
    <button
      type="button"
      id="lb-close"
      class="absolute top-4 right-4 z-10 w-12 h-12 rounded-full bg-white/10 backdrop-blur-sm text-white grid place-items-center hover:bg-white/20 transition-colors"
      aria-label="Lukk"
    >
      <span class="material-symbols-outlined text-2xl">close</span>
    </button>

    <!-- Previous -->
    <button
      type="button"
      id="lb-prev"
      class="absolute left-3 top-1/2 -translate-y-1/2 z-10 w-12 h-12 rounded-full bg-white/10 backdrop-blur-sm text-white grid place-items-center hover:bg-white/20 transition-colors"
      aria-label="Forrige bilde"
    >
      <span class="material-symbols-outlined text-2xl">chevron_left</span>
    </button>

    <!-- Next -->
    <button
      type="button"
      id="lb-next"
      class="absolute right-3 top-1/2 -translate-y-1/2 z-10 w-12 h-12 rounded-full bg-white/10 backdrop-blur-sm text-white grid place-items-center hover:bg-white/20 transition-colors"
      aria-label="Neste bilde"
    >
      <span class="material-symbols-outlined text-2xl">chevron_right</span>
    </button>

    <!-- Image -->
    <img
      id="lb-img"
      class="max-h-[88vh] max-w-[92vw] object-contain select-none rounded-lg"
      alt=""
      draggable="false"
    />

    <!-- Counter -->
    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-white/70 text-sm font-body bg-black/40 px-3 py-1 rounded-full backdrop-blur-sm">
      <span id="lb-counter"></span>
    </div>
  </div>

  <script is:inline>
    (() => {
      // Infinite scroll
      const BATCH = 20;
      let shown = BATCH;
      const sentinel = document.getElementById("gallery-sentinel");
      const grid = document.getElementById("gallery-grid");
      if (sentinel && grid) {
        const observer = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) {
            const items = grid.querySelectorAll("[data-gallery-item]");
            const end = Math.min(shown + BATCH, items.length);
            for (let i = shown; i < end; i++) items[i].classList.remove("hidden");
            shown = end;
            if (shown >= items.length) observer.disconnect();
          }
        }, { rootMargin: "400px" });
        observer.observe(sentinel);
      }

      const lb = document.getElementById("gallery-lightbox");
      const lbImg = document.getElementById("lb-img");
      const lbCounter = document.getElementById("lb-counter");
      const btns = document.querySelectorAll("[data-gallery-btn]");
      const prevBtn = document.getElementById("lb-prev");
      const nextBtn = document.getElementById("lb-next");
      const closeBtn = document.getElementById("lb-close");
      if (!lb || !lbImg || !btns.length) return;

      const sources = Array.from(btns).map((btn) => {
        const img = btn.querySelector("img");
        return img ? { src: img.src, alt: img.alt || "" } : null;
      }).filter(Boolean);
      let current = 0;
      let lastFocused = null;

      // Touch / swipe
      let touchStartX = 0;
      let touchStartY = 0;

      function show(i) {
        if (i < 0 || i >= sources.length) return;
        current = i;
        const s = sources[current];
        lbImg.src = s.src;
        lbImg.alt = s.alt;
        lbCounter.textContent = `${current + 1} / ${sources.length}`;
      }

      function open(i) {
        lastFocused = document.activeElement;
        show(i);
        lb.classList.remove("hidden");
        lb.classList.add("flex");
        lb.setAttribute("aria-hidden", "false");
        document.getElementById("main-content")?.setAttribute("inert", "");
        document.querySelector("header")?.setAttribute("inert", "");
        document.querySelector("footer")?.setAttribute("inert", "");
        closeBtn.focus();
        document.body.style.overflow = "hidden";
      }

      function close() {
        lb.classList.add("hidden");
        lb.classList.remove("flex");
        lb.setAttribute("aria-hidden", "true");
        document.getElementById("main-content")?.removeAttribute("inert");
        document.querySelector("header")?.removeAttribute("inert");
        document.querySelector("footer")?.removeAttribute("inert");
        document.body.style.overflow = "";
        if (lastFocused && document.contains(lastFocused)) lastFocused.focus();
      }

      function next() { show(current + 1); }
      function prev() { show(current - 1); }

      btns.forEach((btn, i) => {
        btn.addEventListener("click", () => open(i));
      });

      closeBtn?.addEventListener("click", close);
      lb?.addEventListener("click", (e) => { if (e.target === lb) close(); });
      nextBtn?.addEventListener("click", next);
      prevBtn?.addEventListener("click", prev);

      // Keyboard
      document.addEventListener("keydown", (e) => {
        if (lb.getAttribute("aria-hidden") === "true") return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowRight") next();
        if (e.key === "ArrowLeft") prev();
      });

      // Swipe on touch
      lb.addEventListener("touchstart", (e) => {
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
      }, { passive: true });

      lb.addEventListener("touchend", (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          if (dx < 0) next(); else prev();
        }
      }, { passive: true });
    })();
  </script>
</Layout>

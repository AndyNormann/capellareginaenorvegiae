---
import { Image } from "astro:assets";

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel?: string;
  afterLabel?: string;
  alt?: string;
}

const {
  before,
  after,
  beforeLabel = "Before",
  afterLabel = "After",
  alt = "",
} = Astro.props;

const id = `slider-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  id={id}
  class="before-after-slider relative w-full overflow-hidden rounded-sm select-none"
  style="cursor: ew-resize;"
>
  <!-- Before image (bottom layer, full width) -->
  <div class="before-img w-full">
    <Image src={before} alt={`${alt} before`} class="w-full h-full object-cover block" draggable="false" />
  </div>

  <!-- After image (top layer, clipped by slider position) -->
  <div
    class="after-img absolute inset-0 overflow-hidden"
    style="clip-path: inset(0 50% 0 0);"
  >
    <Image src={after} alt={`${alt} after`} class="w-full h-full object-cover block" draggable="false" />
    <!-- After label -->
    <div class="absolute top-3 left-3 bg-black/50 text-white font-label text-xs uppercase tracking-widest px-3 py-1 rounded-full backdrop-blur-sm">
      {afterLabel}
    </div>
  </div>

  <!-- Before label -->
  <div class="absolute top-3 right-3 bg-black/50 text-white font-label text-xs uppercase tracking-widest px-3 py-1 rounded-full backdrop-blur-sm">
    {beforeLabel}
  </div>

  <!-- Divider line -->
  <div
    class="slider-line absolute inset-y-0 pointer-events-none"
    style="left: 50%; transform: translateX(-50%);"
  >
    <div class="w-0.5 h-full bg-white/90 shadow-md"></div>
  </div>

  <!-- Handle -->
  <div
    class="slider-handle absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-10 h-10 bg-white rounded-full shadow-xl flex items-center justify-center pointer-events-none z-10"
    style="left: 50%;"
    draggable="false"
  >
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" draggable="false">
      <path d="M6 4L2 9L6 14" stroke="#36557b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12 4L16 9L12 14" stroke="#36557b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</div>

<script define:vars={{ id }}>
  const container = document.getElementById(id);
  const afterImg = container.querySelector(".after-img");
  const line = container.querySelector(".slider-line");
  const handle = container.querySelector(".slider-handle");

  let dragging = false;

  function setPosition(x) {
    const rect = container.getBoundingClientRect();
    const pct = Math.min(Math.max((x - rect.left) / rect.width, 0), 1);
    const right = (1 - pct) * 100;
    afterImg.style.clipPath = `inset(0 ${right}% 0 0)`;
    line.style.left = `${pct * 100}%`;
    handle.style.left = `${pct * 100}%`;
  }

  container.addEventListener("mousedown", (e) => { e.preventDefault(); dragging = true; setPosition(e.clientX); });
  window.addEventListener("mousemove", (e) => { if (dragging) setPosition(e.clientX); });
  window.addEventListener("mouseup", () => { dragging = false; });

  container.addEventListener("touchstart", (e) => { dragging = true; setPosition(e.touches[0].clientX); }, { passive: true });
  window.addEventListener("touchmove", (e) => { if (dragging) setPosition(e.touches[0].clientX); }, { passive: true });
  window.addEventListener("touchend", () => { dragging = false; });
</script>

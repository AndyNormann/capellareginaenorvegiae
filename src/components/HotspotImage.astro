---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * A figure with click/hover hotspots overlaid on the image.
 * Each hotspot is placed by percentage coordinates (x, y) so it
 * stays in the right spot as the image scales.
 */
export interface Hotspot {
  /** Horizontal position, 0–100 (% of image width). */
  x: number;
  /** Vertical position, 0–100 (% of image height). */
  y: number;
  /** Short label shown next to the dot (also the accessible name). */
  label: string;
  /** Tooltip heading. Defaults to label. */
  title?: string;
  /** Tooltip body text. */
  body?: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  hotspots: Hotspot[];
  class?: string;
}

const { src, alt, hotspots = [], class: className = "" } = Astro.props;
const items = hotspots.map((h, i) => ({
  ...h,
  id: `hotspot-${i}`,
}));
---

<figure class:list={["hotspot-image", className]}>
  <Image src={src} alt={alt} class="w-full h-auto block rounded-2xl overflow-hidden" />
  {items.map((h) => (
    <button
      type="button"
      class:list={[
        "hotspot group",
        h.y < 30 ? "hotspot--below" : "",
      ]}
      style={`left:${h.x}%; top:${h.y}%;`}
      aria-describedby={h.id}
      aria-label={h.label}
    >
      <span class="hotspot-dot" aria-hidden="true"></span>
      <span class="hotspot-card" role="tooltip" id={h.id}>
        {h.title && <strong>{h.title}</strong>}
        {h.body && <em>{h.body}</em>}
      </span>
    </button>
  ))}
</figure>

<script>
  // Toggle hotspots on tap (mobile) / keyboard too.
  document.querySelectorAll<HTMLButtonElement>(".hotspot").forEach((btn) => {
    const closeOthers = () =>
      document
        .querySelectorAll<HTMLButtonElement>(".hotspot.open")
        .forEach((b) => {
          if (b !== btn) b.classList.remove("open");
        });

    btn.addEventListener("click", () => {
      const open = btn.classList.contains("open");
      closeOthers();
      btn.classList.toggle("open", !open);

      // Keep the tooltip card within the viewport (esp. for dots near the edges).
      if (!open) {
        const card = btn.querySelector<HTMLElement>(".hotspot-card");
        if (card) {
          const vw = document.documentElement.clientWidth;
          const pad = 12;
          const rect = card.getBoundingClientRect();
          let hx = 0;
          if (rect.right > vw - pad) hx = vw - pad - rect.right;
          if (rect.left < pad) hx = pad - rect.left;
          card.style.setProperty("--hx", hx + "px");
        }
      }
    });
  });
</script>

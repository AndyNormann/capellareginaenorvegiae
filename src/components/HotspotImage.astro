---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * A figure with click/hover hotspots overlaid on the image.
 * Each hotspot is placed by percentage coordinates (x, y) so it
 * stays in the right spot as the image scales.
 */
export interface Hotspot {
  /** Horizontal position, 0–100 (% of image width). */
  x: number;
  /** Vertical position, 0–100 (% of image height). */
  y: number;
  /** Short label shown next to the dot. */
  label: string;
  /** Tooltip heading. Defaults to label. */
  title?: string;
  /** Tooltip body text. */
  body?: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  hotspots: Hotspot[];
  class?: string;
}

const { src, alt, hotspots = [], class: className = "" } = Astro.props;
---

<figure class:list={["hotspot-image", className]}>
  <Image src={src} alt={alt} class="w-full h-auto block" />
  {hotspots.map((h) => (
    <button
      type="button"
      class="hotspot group"
      style={`left:${h.x}%; top:${h.y}%;`}
      aria-label={h.label}
      aria-expanded="false"
    >
      <span class="hotspot-dot" aria-hidden="true"></span>
      <span class="hotspot-label">{h.label}</span>
      <span class="hotspot-card" role="tooltip">
        {h.title && <strong>{h.title}</strong>}
        {h.body && <em>{h.body}</em>}
      </span>
    </button>
  ))}
</figure>

<script>
  // Toggle hotspots on tap (mobile) / keyboard too.
  document.querySelectorAll<HTMLButtonElement>(".hotspot").forEach((btn) => {
    const closeOthers = () =>
      document
        .querySelectorAll<HTMLButtonElement>('.hotspot[aria-expanded="true"]')
        .forEach((b) => {
          if (b !== btn) b.setAttribute("aria-expanded", "false");
        });

    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      closeOthers();
      btn.setAttribute("aria-expanded", String(!open));
    });
  });
</script>

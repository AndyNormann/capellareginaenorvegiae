---
import "../styles/global.css";
import { Image } from "astro:assets";
import topIcon from "@assets/top-icon.png";
import favicon from "../../public/favicon.png";

import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description, ogImage, ogImageAlt } = Astro.props as {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
};

const siteName = "Capella Reginae Norvegiae";
const defaultTitle =
  lang === 'no'
    ? "Mariaslæen – et lite kapell i Gudbrandsdalen"
    : "Mariaslæen – a small chapel in Gudbrandsdalen";
const pageTitle = title ? `${title} — ${siteName}` : `${defaultTitle} — ${siteName}`;

const defaultOgImageAlt = lang === 'no'
  ? "Mariaslæen – et lite kapell i en gammel smie i Gudbrandsdalen"
  : "Mariaslæen – a small chapel in an old forge in Gudbrandsdalen";
const pageOgImageAlt = ogImageAlt ?? defaultOgImageAlt;

const defaultDescription =
  lang === 'no'
    ? "Mariaslæen – et lite kapell i en gammel smie på Ledum gård i Gudbrandsdalen. Bli kjent med kapellet og send oss en melding om du vil besøke oss."
    : "Mariaslæen – a small chapel in an old forge at Ledum farm, Gudbrandsdalen, Norway. Learn about the chapel and message us if you would like to visit.";
const pageDescription = description ?? defaultDescription;

const pathname = Astro.url.pathname.replace(/\/+$/, "");
const baseUrl = 'https://capellareginae.no';
const canonicalUrl = `${baseUrl}${pathname}`;
const isActive = (slug: string) => pathname.endsWith(`/${lang}/${slug}`) || (lang === 'no' && pathname === `/${slug}`);

const segments = pathname.split("/").filter(Boolean);
const otherLang = lang === "no" ? "en" : "no";
// For English pages (/en/plans), skip the lang prefix. For Norwegian root pages (/plans), include the slug.
const restPath = lang === "no" ? segments.join("/") : segments.slice(1).join("/");
const langHome = lang === "no" ? "/" : `/${lang}`;
const noHref = lang === "no" ? "/" + restPath : restPath ? `/${restPath}` : "/";
const enHref = `/en${restPath ? "/" + restPath : ""}`;

const navPages = [
  { slug: "story", label: t("nav.story") },
  { slug: "smia", label: t("nav.smia") },
  { slug: "ourlady", label: t("nav.ourlady") },
  { slug: "plans", label: t("nav.plans") },
  { slug: "besokende", label: t("nav.besokende") },
];

const defaultOgImage = `${baseUrl}/og-default.png`;
const pageOgImage = ogImage ?? defaultOgImage;

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LandmarksOrHistoricalBuildings",
  "name": "Mariaslæen – Capella Reginae Norvegiae",
  "alternateName": "Mariaslæen",
  "description": pageDescription,
  "url": canonicalUrl,
  "image": pageOgImage,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Øyer",
    "addressRegion": "Innlandet",
    "addressCountry": "NO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 61.3,
    "longitude": 10.4
  },
  "founder": [
    {
      "@type": "Person",
      "name": "Mathias Bruno Ledum"
    }
  ],
  "parentOrganization": {
    "@type": "Organization",
    "name": "Capella Reginae Norvegiae",
    "url": baseUrl
  },
  "sameAs": [
    "https://www.instagram.com/capellareginaenorvegiae/"
  ]
};
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
		<link rel="icon" href={favicon.src} sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang="no" href={`${baseUrl}${noHref}`} />
    <link rel="alternate" hreflang="en" href={`${baseUrl}${enHref}`} />
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}${noHref}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={pageOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageOgImageAlt} />
    <meta property="og:locale" content={lang === 'no' ? 'nb_NO' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'no' ? 'en_US' : 'nb_NO'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageOgImage} />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Epilogue:ital,wght@0,100..900;1,100..900&family=Caveat:wght@400..700&display=swap"
    rel="stylesheet"
    />
    <!-- Material Symbols -->
    <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet"
    />

    <!-- Preconnect for YouTube embeds -->
    <link rel="preconnect" href="https://www.youtube-nocookie.com" crossorigin />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": lang === 'no' ? 'Hjem' : 'Home',
          "item": baseUrl
        },
        ...(pathname !== '/' ? [{
          "@type": "ListItem",
          "position": 2,
          "name": pageTitle.split(' \u2014 ')[0],
          "item": canonicalUrl
        }] : [])
      ]
    })} />
  </head>
  <body
  class="bg-background text-on-surface font-body selection:bg-primary-fixed selection:text-on-primary-fixed min-h-screen"
  >
    <script is:inline>
      // Flag JS availability so scroll-reveal only hides content when JS is on.
      document.documentElement.classList.replace("no-js", "js");
    </script>

    <a href="#main-content" class="skip-link">
      {lang === 'no' ? 'Hopp til innhold' : 'Skip to content'}
    </a>
    <header id="site-header" class="sticky top-0 z-40">
      <nav
      aria-label={t("nav.main")}
      class="flex justify-between items-center w-full pl-2 pr-4 py-3 max-w-6xl mx-auto"
      >
        <a class="flex items-center gap-3" href={langHome} aria-current={pathname === `/${lang}` || pathname === `/${lang}/` ? "page" : undefined}>
          <Image src={topIcon} alt="Glassmaling" class="w-11 h-11 md:w-14 md:h-14" loading="eager" />
          <div class="leading-tight hidden sm:block">
            <div class="text-sm md:text-base font-semibold font-headline italic tracking-tight text-on-surface">
              Capella Reginae Norvegiae
            </div>
            <div class="text-xs font-body tracking-wide text-on-surface-variant hidden sm:block">Gudbrandsdalen</div>
          </div>
        </a>
        <div class="flex gap-3 md:gap-6 items-center">
          {navPages.map((p) => (
            <a
            href={lang === 'no' ? `/${p.slug}` : `/${lang}/${p.slug}`}
            class:list={[
              "font-headline italic text-base tracking-tight hover:text-on-surface transition-colors hidden sm:inline-flex items-center min-h-[44px] px-2",
              isActive(p.slug) ? "text-on-surface underline decoration-secondary decoration-2 underline-offset-4" : "text-on-surface-variant",
            ]}
            aria-current={isActive(p.slug) ? "page" : undefined}
            >{p.label}</a
            >
          ))}
          <!-- Mobile menu toggle -->
          <button
          type="button"
          id="nav-toggle"
          class="sm:hidden min-h-[44px] min-w-[44px] flex items-center justify-center text-on-surface hover:text-primary transition-colors"
          aria-label={t("nav.menu")}
          aria-expanded="false"
          aria-controls="mobile-menu"
          >
            <span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
          </button>
          <!-- Language switcher -->
          <div class="flex items-center gap-0 font-label text-on-surface-variant" role="group" aria-label={t("lang.label")}>
            <a href={noHref}
               class="min-h-[44px] min-w-[44px] flex items-center justify-center text-sm hover:text-on-surface transition-colors"
               class:list={[lang === 'no' ? 'text-on-surface font-semibold' : '']}
               aria-label="Norsk" lang="no" hreflang="no"
               aria-current={lang === 'no' ? 'page' : undefined}>NO</a>
            <span class="opacity-30 select-none" aria-hidden="true">|</span>
            <a href={enHref}
               class="min-h-[44px] min-w-[44px] flex items-center justify-center text-sm hover:text-on-surface transition-colors"
               class:list={[lang === 'en' ? 'text-on-surface font-semibold' : '']}
               aria-label="English" lang="en" hreflang="en"
               aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          </div>
          <a
          href={lang === 'no' ? '/support' : `/${lang}/support`}
          class:list={[
            "min-h-[44px] px-4 md:px-5 flex items-center border border-outline rounded-sm transition-all font-label text-sm",
            isActive("support") ? "bg-surface-container text-on-surface font-semibold" : "text-on-surface hover:bg-surface-container",
          ]}
          aria-current={isActive("support") ? "page" : undefined}
          >{t("nav.support")}</a>
        </div>
      </nav>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="sm:hidden hidden border-t border-outline-variant bg-surface-bright">
        <div class="max-w-6xl mx-auto px-4 py-2 flex flex-col">
          {navPages.map((p) => (
            <a
            href={lang === 'no' ? `/${p.slug}` : `/${lang}/${p.slug}`}
            class="min-h-[44px] flex items-center font-headline italic text-base text-on-surface-variant hover:text-on-surface"
            aria-current={isActive(p.slug) ? "page" : undefined}
            >{p.label}</a
            >
          ))}
        </div>
      </div>
    </header>
    <slot />

    <script>
      const navToggle = document.getElementById("nav-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      if (navToggle && mobileMenu) {
        navToggle.addEventListener("click", () => {
          const open = mobileMenu.classList.toggle("hidden") === false;
          navToggle.setAttribute("aria-expanded", String(open));
        });
        mobileMenu.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
            navToggle.setAttribute("aria-expanded", "false");
          });
        });
        mobileMenu.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            mobileMenu.classList.add("hidden");
            navToggle.setAttribute("aria-expanded", "false");
            navToggle.focus();
          }
        });
      }
    </script>

    <script>
      // Nav glass effect on scroll
      const header = document.getElementById("site-header");
      function updateNav() {
        if (window.scrollY > 40) {
          header?.classList.add("scrolled");
        } else {
          header?.classList.remove("scrolled");
        }
      }
      window.addEventListener("scroll", updateNav, { passive: true });
      updateNav();

      // Scroll-reveal
      const revealEls = document.querySelectorAll(".reveal");
      if (revealEls.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        revealEls.forEach((el) => observer.observe(el));
      }
    </script>

  <footer class="w-full mt-20 pb-12 pt-12 border-t border-outline-variant">
    <div class="max-w-4xl mx-auto px-4">
      <div class="flex flex-col items-center gap-5 text-center">
        <!-- Ornamental divider -->
        <div class="flex items-center gap-4 w-full max-w-xs opacity-40 mb-2" aria-hidden="true">
          <div class="flex-1 h-px bg-outline-variant"></div>
          <span class="text-secondary text-sm">✦</span>
          <div class="flex-1 h-px bg-outline-variant"></div>
        </div>

        <div class="text-xl font-medium font-headline italic text-on-surface">
          Capella Reginae Norvegiae
        </div>
        <p class="font-headline text-sm italic text-on-surface-variant max-w-xs">
          Built with love in Gudbrandsdalen.
        </p>

        <!-- Footer navigation -->
        <nav aria-label={t("nav.footer")} class="flex flex-wrap justify-center gap-x-6 gap-y-1">
          {navPages.map((p) => (
            <a
            href={lang === 'no' ? `/${p.slug}` : `/${lang}/${p.slug}`}
            class="min-h-[44px] inline-flex items-center font-body text-sm text-on-surface-variant hover:text-on-surface transition-colors"
            aria-current={isActive(p.slug) ? "page" : undefined}
            >{p.label}</a
            >
          ))}
          <a
          href={lang === 'no' ? '/support' : `/${lang}/support`}
          class="min-h-[44px] inline-flex items-center font-body text-sm text-on-surface-variant hover:text-on-surface transition-colors"
          aria-current={isActive("support") ? "page" : undefined}
          >{t("nav.support")}</a>
        </nav>

        <a
          href="https://www.instagram.com/capellareginaenorvegiae/"
          target="_blank"
          rel="noopener noreferrer"
          class="min-h-[44px] px-4 inline-flex items-center gap-2 text-on-surface-variant hover:text-on-surface transition-colors font-body text-sm"
          aria-label="Instagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          Instagram
        </a>

        <div class="flex items-center gap-1 text-sm font-body">
          <a class="min-h-[44px] px-4 inline-flex items-center text-on-surface-variant hover:text-on-surface transition-colors" href={noHref} lang="no" hreflang="no" aria-current={lang === 'no' ? 'page' : undefined}>Norsk</a>
          <span class="text-on-surface-variant/30" aria-hidden="true">·</span>
          <a class="min-h-[44px] px-4 inline-flex items-center text-on-surface-variant hover:text-on-surface transition-colors" href={enHref} lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>English</a>
        </div>

        <div class="text-xs font-label text-on-surface-variant mt-1">
          © {new Date().getFullYear()} Mathias and his companions.
        </div>
      </div>
    </div>
  </footer>
  </body>
</html>

<style>
html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
}
</style>

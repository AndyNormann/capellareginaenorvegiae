---
import "../styles/global.css";
import { Image } from "astro:assets";
import topIcon from "@assets/glassmaleri.png";
import favicon from "@assets/glassmaleri.png";

import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Capella Reginae Norvegiae</title>
    <link rel="icon" href={favicon.src} type="image/x-icon" />

    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Epilogue:ital,wght@0,100..900;1,100..900&family=Caveat:wght@400..700&display=swap"
    rel="stylesheet"
    />
    <!-- Material Symbols -->
    <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet"
    />
  </head>
  <script is:inline>
    const saved = localStorage.getItem("theme");
    if (saved) document.documentElement.setAttribute("data-theme", saved);
  </script>
  <body
  class="valley-bg text-on-surface font-body selection:bg-primary-fixed selection:text-on-primary-fixed min-h-screen relative"
  >
    <header class="sticky top-0 z-40">
      <nav
      class="flex justify-between items-center w-full pl-2 pr-6 py-3 max-w-6xl mx-auto"
      >
        <a class="flex items-center gap-3" href="/capellareginaenorvegiae">
          <Image src={topIcon} alt="Glassmaling" class="w-11 h-11 md:w-14 md:h-14 drop-shadow-md" />
          <div class="leading-tight hidden md:block">
            <div class="text-base font-semibold font-['Newsreader'] italic tracking-tight text-white [text-shadow:0_1px_4px_rgba(0,0,0,0.8),0_2px_12px_rgba(0,0,0,0.5)]">
              Capella Reginae Norvegiae
            </div>
            <div class="text-xs font-['Plus_Jakarta_Sans'] tracking-wide text-white/80 [text-shadow:0_1px_4px_rgba(0,0,0,0.8)]">Gudbrandsdalen</div>
          </div>
        </a>
        <div class="flex gap-6 items-center">
          <a
          class="font-['Newsreader'] italic text-base tracking-tight text-white/90 hover:text-white transition-colors [text-shadow:0_1px_4px_rgba(0,0,0,0.8),0_2px_8px_rgba(0,0,0,0.5)]"
          href="story">{t("nav.story")}</a
          >
          <a
          class="font-['Newsreader'] italic text-base tracking-tight text-white/90 hover:text-white transition-colors [text-shadow:0_1px_4px_rgba(0,0,0,0.8),0_2px_8px_rgba(0,0,0,0.5)]"
          href="/capellareginaenorvegiae">{t("nav.chapel")}</a
          >
          <a
          class="px-4 py-1.5 border border-white/50 text-white hover:bg-white/20 rounded-sm transition-all font-['Newsreader'] italic text-sm [text-shadow:0_1px_4px_rgba(0,0,0,0.8)]"
          href="https://www.spleis.no/project/485151?s=c"
          target="_blank">{t("nav.contact")}</a
          >
        </div>
      </nav>
    </header>
    <slot />

    <!-- Theme Switcher -->
    <div class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-2" id="theme-switcher">
      <div id="theme-panel" class="hidden flex-col gap-1.5 mb-1 bg-black/30 backdrop-blur-xl rounded-2xl p-2 shadow-2xl border border-white/10">
        <button data-theme-value="" class="theme-btn flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-label transition-all" style="background:#fbf9f4; color:#36557b;">
          <span class="w-4 h-4 rounded-full flex-shrink-0" style="background:linear-gradient(135deg,#36557b,#7b581e);"></span>
          <span class="flex-1 text-left">Fjord</span>
          <span class="check-icon opacity-0 text-base leading-none">✓</span>
        </button>
        <button data-theme-value="natt" class="theme-btn flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-label transition-all" style="background:#0e1c2e; color:#60b8ff;">
          <span class="w-4 h-4 rounded-full flex-shrink-0" style="background:linear-gradient(135deg,#080f18,#60b8ff);"></span>
          <span class="flex-1 text-left">Natt</span>
          <span class="check-icon opacity-0 text-base leading-none">✓</span>
        </button>
        <button data-theme-value="jord" class="theme-btn flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-label transition-all" style="background:#eeddc8; color:#1848a0;">
          <span class="w-4 h-4 rounded-full flex-shrink-0" style="background:linear-gradient(135deg,#1848a0,#b03818);"></span>
          <span class="flex-1 text-left">Jord</span>
          <span class="check-icon opacity-0 text-base leading-none">✓</span>
        </button>
        <button data-theme-value="is" class="theme-btn flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-label transition-all" style="background:#d8ecff; color:#001870;">
          <span class="w-4 h-4 rounded-full flex-shrink-0" style="background:linear-gradient(135deg,#001870,#0858a8);"></span>
          <span class="flex-1 text-left">Is</span>
          <span class="check-icon opacity-0 text-base leading-none">✓</span>
        </button>
        <button data-theme-value="pastell" class="theme-btn flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-label transition-all" style="background:#ede8ff; color:#4858c0;">
          <span class="w-4 h-4 rounded-full flex-shrink-0" style="background:linear-gradient(135deg,#4858c0,#c04888);"></span>
          <span class="flex-1 text-left">Pastell</span>
          <span class="check-icon opacity-0 text-base leading-none">✓</span>
        </button>
      </div>
      <button id="theme-toggle" class="w-11 h-11 rounded-full shadow-xl flex items-center justify-center backdrop-blur-md border border-white/20 bg-surface-bright/80 text-primary hover:scale-110 transition-transform" aria-label="Change theme">
        <span class="material-symbols-outlined text-xl">palette</span>
      </button>
    </div>

    <script>
      const toggle = document.getElementById("theme-toggle");
      const panel = document.getElementById("theme-panel");
      const buttons = document.querySelectorAll<HTMLElement>(".theme-btn");

      function updateActive() {
        const current = document.documentElement.getAttribute("data-theme") ?? "";
        buttons.forEach((btn) => {
          const isActive = btn.dataset.themeValue === current;
          btn.querySelector(".check-icon")?.classList.toggle("opacity-0", !isActive);
          btn.style.outline = isActive ? "2px solid currentColor" : "none";
          btn.style.outlineOffset = "1px";
        });
      }

      toggle?.addEventListener("click", (e) => {
        e.stopPropagation();
        panel?.classList.toggle("hidden");
        panel?.classList.toggle("flex");
      });

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const value = btn.dataset.themeValue ?? "";
          if (value) {
            document.documentElement.setAttribute("data-theme", value);
            localStorage.setItem("theme", value);
          } else {
            document.documentElement.removeAttribute("data-theme");
            localStorage.removeItem("theme");
          }
          updateActive();
          panel?.classList.add("hidden");
          panel?.classList.remove("flex");
        });
      });

      document.addEventListener("click", (e) => {
        if (!document.getElementById("theme-switcher")?.contains(e.target as Node)) {
          panel?.classList.add("hidden");
          panel?.classList.remove("flex");
        }
      });

      updateActive();
    </script>
  </body>

  <footer class="w-full mt-20 pb-12 pt-8">
    <div
    class="flex flex-col items-center gap-4 w-full px-4 max-w-4xl mx-auto text-center"
    style="text-shadow: 0 1px 6px rgba(0,0,0,1), 0 3px 20px rgba(0,0,0,0.8);"
    >
      <div class="text-lg font-medium font-['Newsreader'] italic text-white">
        Capella Reginae Norvegiae
      </div>
      <p class="font-['Newsreader'] text-sm italic text-white/90">
        Built with love in Gudbrandsdalen.
      </p>
      <p>
        <a class="text-sm pr-4 text-white hover:underline transition-colors" href="/capellareginaenorvegiae/no">Norsk</a>
        <a class="text-sm text-white hover:underline transition-colors" href="/capellareginaenorvegiae/en">English</a>
      </p>
      <div class="mt-2 text-xs font-label text-white/80">
        © 2026 Mathias and his companions.
      </div>
    </div>
  </footer>
</html>

<style>
html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
}

.valley-bg {
  background-image: url("@assets/dalen1.jpg");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
}
</style>

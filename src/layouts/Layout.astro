---
import "../styles/global.css";
import { Image } from "astro:assets";
import topIcon from "@assets/glassmaleri.png";
import favicon from "@assets/glassmaleri.png";

import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Capella Reginae Norvegiae</title>
    <link rel="icon" href={favicon.src} type="image/x-icon" />

    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Epilogue:ital,wght@0,100..900;1,100..900&family=Caveat:wght@400..700&display=swap"
    rel="stylesheet"
    />
    <!-- Material Symbols -->
    <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet"
    />
  </head>
  <script is:inline>
    const saved = localStorage.getItem("theme");
    if (saved) document.documentElement.setAttribute("data-theme", saved);
  </script>
  <body
  class="valley-bg text-on-surface font-body selection:bg-primary-fixed selection:text-on-primary-fixed min-h-screen relative"
  >
    <header
    class="bg-[#fbf9f4]/85 backdrop-blur-md sticky top-0 z-40 border-b border-stone-200/40"
    >
      <nav
      class="flex justify-between items-center w-full pl-2 pr-6 py-3 max-w-6xl mx-auto"
      >
        <a class="flex items-center gap-3" href="/capellareginaenorvegiae">
          <Image src={topIcon} alt="Glassmaling" class="w-11 h-11 md:w-14 md:h-14" />
          <div class="leading-tight hidden md:block">
            <div class="text-base font-semibold text-primary font-['Newsreader'] italic tracking-tight">
              Capella Reginae Norvegiae
            </div>
            <div class="text-xs text-secondary/70 font-['Plus_Jakarta_Sans'] tracking-wide">Gudbrandsdalen</div>
          </div>
        </a>
        <div class="flex gap-6 items-center">
          <a
          class="text-stone-700 hover:text-primary transition-colors font-['Newsreader'] italic text-base tracking-tight"
          href="story">{t("nav.story")}</a
          >
          <a
          class="text-stone-700 hover:text-primary transition-colors font-['Newsreader'] italic text-base tracking-tight"
          href="/capellareginaenorvegiae">{t("nav.chapel")}</a
          >
          <a
          class="px-4 py-1.5 border border-primary/40 text-primary hover:bg-primary hover:text-on-primary rounded-sm transition-all font-['Newsreader'] italic text-sm"
          href="https://www.spleis.no/project/485151?s=c"
          target="_blank">{t("nav.contact")}</a
          >
        </div>
      </nav>
    </header>
    <slot />

    <!-- Theme Switcher -->
    <div class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-2" id="theme-switcher">
      <div id="theme-panel" class="hidden flex-col gap-2 mb-1">
        <button data-theme-value="" class="theme-btn flex items-center gap-3 px-4 py-2.5 rounded-full text-sm font-label shadow-lg backdrop-blur-md border border-white/20 bg-[#fbf9f4]/90 text-[#36557b] hover:scale-105 transition-transform">
          <span class="w-4 h-4 rounded-full border border-black/10 flex-shrink-0" style="background: linear-gradient(135deg, #36557b, #7b581e);"></span>
          Fjord
        </button>
        <button data-theme-value="natt" class="theme-btn flex items-center gap-3 px-4 py-2.5 rounded-full text-sm font-label shadow-lg backdrop-blur-md border border-white/10 bg-[#1e2c3d]/90 text-[#8bbef7] hover:scale-105 transition-transform">
          <span class="w-4 h-4 rounded-full border border-white/10 flex-shrink-0" style="background: linear-gradient(135deg, #1e2c3d, #8bbef7);"></span>
          Natt
        </button>
        <button data-theme-value="is" class="theme-btn flex items-center gap-3 px-4 py-2.5 rounded-full text-sm font-label shadow-lg backdrop-blur-md border border-blue-100 bg-[#f0f8ff]/90 text-[#1a4f8c] hover:scale-105 transition-transform">
          <span class="w-4 h-4 rounded-full border border-black/10 flex-shrink-0" style="background: linear-gradient(135deg, #1a4f8c, #3d80b0);"></span>
          Is
        </button>
        <button data-theme-value="kobber" class="theme-btn flex items-center gap-3 px-4 py-2.5 rounded-full text-sm font-label shadow-lg backdrop-blur-md border border-orange-100 bg-[#fdf8f3]/90 text-[#1e4fa8] hover:scale-105 transition-transform">
          <span class="w-4 h-4 rounded-full border border-black/10 flex-shrink-0" style="background: linear-gradient(135deg, #1e4fa8, #b8521a);"></span>
          Kobber
        </button>
      </div>
      <button id="theme-toggle" class="w-11 h-11 rounded-full shadow-xl flex items-center justify-center backdrop-blur-md border border-white/20 bg-surface-bright/80 text-primary hover:scale-110 transition-transform" aria-label="Change theme">
        <span class="material-symbols-outlined text-xl">palette</span>
      </button>
    </div>

    <script>
      const toggle = document.getElementById("theme-toggle");
      const panel = document.getElementById("theme-panel");
      const buttons = document.querySelectorAll(".theme-btn");

      toggle?.addEventListener("click", () => {
        panel?.classList.toggle("hidden");
        panel?.classList.toggle("flex");
      });

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const value = (btn as HTMLElement).dataset.themeValue ?? "";
          if (value) {
            document.documentElement.setAttribute("data-theme", value);
            localStorage.setItem("theme", value);
          } else {
            document.documentElement.removeAttribute("data-theme");
            localStorage.removeItem("theme");
          }
          panel?.classList.add("hidden");
          panel?.classList.remove("flex");
        });
      });

      document.addEventListener("click", (e) => {
        if (!document.getElementById("theme-switcher")?.contains(e.target as Node)) {
          panel?.classList.add("hidden");
          panel?.classList.remove("flex");
        }
      });
    </script>
  </body>

  <footer
  class="bg-[#fbf9f4]/90 backdrop-blur-sm w-full mt-20 pb-12 border-t border-stone-300/30 pt-8"
  >
    <div
    class="flex flex-col items-center gap-4 w-full px-4 max-w-4xl mx-auto text-center"
    >
      <div
      class="text-lg font-medium text-stone-900 font-['Newsreader'] italic"
      >
        Capella Reginae Norvegiae
      </div>
      <p class="font-['Newsreader'] serif text-sm italic text-secondary">
        Built with love in Gudbrandsdalen.
      </p>
      <p>
        <a class="text-sm pr-4 hover:underline" href="/capellareginaenorvegiae/no">Norsk</a>
        <a class="text-sm hover:underline" href="/capellareginaenorvegiae/en">English</a>
      </p>
      <div class="mt-4 text-xs font-label text-stone-500">
        © 2026 Mathias and his companions.
      </div>
    </div>
  </footer>
</html>

<style>
html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
}

.valley-bg {
  background-image: url("@assets/dalen1.jpg");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
}
</style>
